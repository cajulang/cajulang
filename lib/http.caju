# std/http: a small HTTP/1.1 server and client.
#
#   import "std/http"
#   http.handle("/", fn(req: *http.Request, res: *http.Response) { res.write("hello world") })
#   err := http.listen_and_serve("0.0.0.0", 3200)
#
# listen_and_serve runs an event loop (epoll) in one process: many connections stay open at the
# same time, each kept alive for more requests (HTTP/1.1 keep-alive, pipelined requests answered
# in order) until the client asks to close, the connection is idle for idle_timeout or has served
# max_requests. Handlers run one at a time, so a slow handler delays every connection.
#
# listen_and_serve_workers(host, port, n) runs n such processes (fork) on the same port
# (SO_REUSEPORT: the kernel spreads the connections among them). Each process has its own copy
# of the program's memory: globals changed by a handler (an in-memory list, a counter...) are NOT
# shared between the processes. Use it for stateless handlers or state kept elsewhere.

import "std/net"
import "std/strings"
import "std/strconv"
import "std/os"

export struct Request {
  method: str
  path: str               # without the query string
  query: str              # what follows "?" in the target, without the "?"
  version: str
  headers: map[str]str    # names in lower case
  body: str
  remote_addr: str        # "ip:port" of the client ("" when unknown)
}

export struct Response {
  status: int
  headers: map[str]str
  body: strings.Builder
}

export fn (r: *Response) set_header(name: str, value: str) { r.headers[name] = value }
export fn (r: *Response) set_status(code: int) { r.status = code }
export fn (r: *Response) write(s: str) { r.body.write(s) }

# the header value for name (any case), or ""
export fn (r: *Request) header(name: str) -> str {
  for i := 0; i < len(name); i++ {
    c := int(name[i])
    if c >= 65 && c <= 90 { return r.headers[strings.to_lower(name)] }
  }
  return r.headers[name]
}

let routes = map[str]fn(*Request, *Response){}
let exact_routes: int = 0          # registered paths not ending in "/"
# the paths ending in "/" and their handlers, longest first (the first that matches wins)
let prefixes = []str{}
let prefix_handlers = []fn(*Request, *Response){}

# registers a handler for a path; a path ending in "/" also matches everything below it
export fn handle(path: str, h: fn(*Request, *Response)) {
  _, had := routes[path]
  routes[path] = h
  if !strings.has_suffix(path, "/") {
    if !had { exact_routes++ }
    return
  }
  for i, p := range prefixes {
    if p == path {
      prefix_handlers[i] = h
      return
    }
  }
  at := len(prefixes)
  for i, p := range prefixes {
    if len(p) < len(path) {
      at = i
      break
    }
  }
  prefixes = append(prefixes, path)
  prefix_handlers = append(prefix_handlers, h)
  for j := len(prefixes) - 1; j > at; j-- {
    prefixes[j] = prefixes[j - 1]
    prefix_handlers[j] = prefix_handlers[j - 1]
  }
  prefixes[at] = path
  prefix_handlers[at] = h
}

let idle_timeout_ms: int = 5000
let max_requests: int = 10000

# how long a kept-alive connection may stay without traffic before the server closes it
export fn set_idle_timeout(ms: int) { idle_timeout_ms = ms }
# how many requests one connection may make before the server closes it (0: no limit)
export fn set_max_requests(n: int) { max_requests = n }

export fn status_text(code: int) -> str {
  switch code {
  case 200: return "OK"
  case 201: return "Created"
  case 202: return "Accepted"
  case 204: return "No Content"
  case 301: return "Moved Permanently"
  case 302: return "Found"
  case 303: return "See Other"
  case 304: return "Not Modified"
  case 307: return "Temporary Redirect"
  case 308: return "Permanent Redirect"
  case 400: return "Bad Request"
  case 401: return "Unauthorized"
  case 403: return "Forbidden"
  case 404: return "Not Found"
  case 405: return "Method Not Allowed"
  case 408: return "Request Timeout"
  case 409: return "Conflict"
  case 411: return "Length Required"
  case 413: return "Payload Too Large"
  case 422: return "Unprocessable Entity"
  case 429: return "Too Many Requests"
  case 431: return "Request Header Fields Too Large"
  case 500: return "Internal Server Error"
  case 501: return "Not Implemented"
  case 503: return "Service Unavailable"
  }
  return "Status " + str(code)
}

# the handler for a path: an exact match, else the longest registered prefix ending in "/"
fn find_route(path: str) -> (fn(*Request, *Response), bool) {
  # an exact match first (a path ending in "/" is also the longest prefix of itself)
  if exact_routes > 0 {
    if h, ok := routes[path]; ok { return h, true }
  }
  for i, p := range prefixes {
    if strings.has_prefix(path, p) { return prefix_handlers[i], true }
  }
  return nil, false
}

const MAX_HEADER = 65536
const MAX_BODY = 16777216

# ---------------------------------------------------------------- bytes in memory

fn mcopy(d: int, s: int, n: int) {
  i := 0
  while i + 8 <= n {
    __store64(d + i, __load64(s + i))
    i += 8
  }
  while i < n {
    __store8(d + i, __load8(s + i))
    i++
  }
}

# n bytes at p as a new string (bytes kept as they are)
fn mem_str(p: int, n: int) -> str {
  m := __newstr(n)
  mcopy(m + 8, p, n)
  return __pstr(m)
}

# the same, ASCII letters in lower case (header names)
fn mem_lower(p: int, n: int) -> str {
  m := __newstr(n)
  for i := 0; i < n; i++ {
    c := __load8(p + i)
    if c >= 65 && c <= 90 { c += 32 }
    __store8(m + 8 + i, c)
  }
  return __pstr(m)
}

# do the n bytes at p equal t? With fold, ASCII letters of p count as lower case (t in lower case)
fn mem_is(p: int, n: int, t: str, fold: bool) -> bool {
  if n != len(t) { return false }
  tp := __strp(t) + 8
  for i := 0; i < n; i++ {
    c := __load8(p + i)
    if fold && c >= 65 && c <= 90 { c += 32 }
    if c != __load8(tp + i) { return false }
  }
  return true
}

# texts that arrive in almost every request: returned without allocating a new string
let KNOWN_METHODS = []str{"GET", "POST", "PUT", "DELETE", "PATCH", "HEAD", "OPTIONS", "HTTP/1.1", "HTTP/1.0"}
let KNOWN_HEADERS = []str{"host", "user-agent", "accept", "accept-encoding", "accept-language", "connection", "content-type", "content-length", "authorization", "cookie", "origin", "referer", "cache-control", "x-forwarded-for", "x-real-ip", "upgrade-insecure-requests", "sec-fetch-mode", "sec-fetch-site", "sec-fetch-dest", "if-none-match", "if-modified-since", "pragma", "dnt"}

# mem_str, reusing a known text when the bytes are one of them
fn mem_known(p: int, n: int, known: []str, fold: bool) -> str {
  for _, k := range known { if mem_is(p, n, k, fold) { return k } }
  if fold { return mem_lower(p, n) }
  return mem_str(p, n)
}

# does s equal t ignoring the case of ASCII letters? (t in lower case)
fn eq_fold(s: str, t: str) -> bool {
  n := len(s)
  if n != len(t) { return false }
  ps := __strp(s) + 8
  pt := __strp(t) + 8
  for i := 0; i < n; i++ {
    c := __load8(ps + i)
    if c >= 65 && c <= 90 { c += 32 }
    if c != __load8(pt + i) { return false }
  }
  return true
}

# does the comma-separated header value contain the token t (lower case), in any case?
fn has_token(v: str, t: str) -> bool {
  if v == "" { return false }
  p := __strp(v) + 8
  n := len(v)
  a := 0
  while a <= n {
    b := a
    while b < n && __load8(p + b) != 44 { b++ }
    s := a
    e := b
    while s < e && (__load8(p + s) == 32 || __load8(p + s) == 9) { s++ }
    while e > s && (__load8(p + e - 1) == 32 || __load8(p + e - 1) == 9) { e-- }
    if mem_is(p + s, e - s, t, true) { return true }
    a = b + 1
  }
  return false
}

# ---------------------------------------------------------------- connections

# one client connection: what arrived and is not handled yet, and what is still to be sent
struct Peer {
  conn: *net.Conn
  inb: int        # input buffer memory
  icap: int
  start: int      # first byte not consumed
  end: int        # bytes in the buffer
  scanned: int    # the end of the headers was searched for up to here
  outb: int       # output buffer memory
  ocap: int
  out_off: int    # first byte not sent yet
  out_n: int      # bytes in the output buffer
  last: int       # time of the last activity (ms)
  served: int     # requests answered
  closing: bool   # close once the output is sent
  dead: bool
  waiting_out: bool
}

# Buffers start small (they grow when needed) and closed connections give their Peer back for
# the next one, so a burst of short connections makes little garbage.
const BUF = 4087          # with the string header, a 4 KB allocation
let free_peers = []*Peer{}

fn new_peer(c: *net.Conn) -> *Peer {
  n := len(free_peers)
  if n > 0 {
    cl := free_peers[n - 1]
    free_peers = free_peers[0:n - 1]
    cl.conn = c
    return cl
  }
  return &Peer{conn: c, inb: __newstr(BUF) + 8, icap: BUF, outb: __newstr(BUF) + 8, ocap: BUF}
}

# closes the connection and keeps the Peer (with buffers of the starting size) for reuse
fn release(cl: *Peer) {
  cl.conn.close()
  cl.conn = nil
  if len(free_peers) >= 1024 { return }
  if cl.icap != BUF {
    cl.inb = __newstr(BUF) + 8
    cl.icap = BUF
  }
  if cl.ocap != BUF {
    cl.outb = __newstr(BUF) + 8
    cl.ocap = BUF
  }
  cl.start = 0
  cl.end = 0
  cl.scanned = 0
  cl.out_off = 0
  cl.out_n = 0
  cl.last = 0
  cl.served = 0
  cl.closing = false
  cl.dead = false
  cl.waiting_out = false
  free_peers = append(free_peers, cl)
}

# room for at least n more bytes of input (moves the unconsumed bytes to the front)
fn (cl: *Peer) in_room(n: int) {
  if cl.start > 0 {
    k := cl.end - cl.start
    if k > 0 { mcopy(cl.inb, cl.inb + cl.start, k) }
    cl.scanned -= cl.start
    if cl.scanned < 0 { cl.scanned = 0 }
    cl.end = k
    cl.start = 0
  }
  if cl.icap - cl.end >= n { return }
  c := cl.icap * 2
  while c - cl.end < n { c = c * 2 }
  m := __newstr(c) + 8
  mcopy(m, cl.inb, cl.end)
  cl.inb = m
  cl.icap = c
}

fn (cl: *Peer) out_room(n: int) {
  if cl.ocap - cl.out_n >= n { return }
  c := cl.ocap * 2
  while c - cl.out_n < n { c = c * 2 }
  m := __newstr(c) + 8
  mcopy(m, cl.outb, cl.out_n)
  cl.outb = m
  cl.ocap = c
}

fn (cl: *Peer) put(s: str) {
  n := len(s)
  cl.out_room(n)
  mcopy(cl.outb + cl.out_n, __strp(s) + 8, n)
  cl.out_n += n
}

# the decimal digits of v >= 0
fn (cl: *Peer) put_int(v: int) {
  cl.out_room(20)
  d := 1
  while d * 10 <= v { d *= 10 }
  while d > 0 {
    __store8(cl.outb + cl.out_n, 48 + v / d % 10)
    cl.out_n++
    d /= 10
  }
}

fn (cl: *Peer) put_mem(p: int, n: int) {
  cl.out_room(n)
  mcopy(cl.outb + cl.out_n, p, n)
  cl.out_n += n
}

# Takes one complete request from the input buffer: (req, 0) when one is ready, (nil, 0) when
# more bytes are needed, (nil, status) for a request that cannot be served.
fn (cl: *Peer) take_request() -> (*Request, int) {
  p := cl.inb
  i := cl.scanned
  if i < cl.start { i = cl.start }
  head_end := -1
  while i + 4 <= cl.end {
    if __load8(p + i + 3) == 10 && __load8(p + i + 2) == 13 && __load8(p + i + 1) == 10 && __load8(p + i) == 13 {
      head_end = i
      break
    }
    i++
  }
  if head_end < 0 {
    cl.scanned = i
    if cl.end - cl.start > MAX_HEADER { return nil, 431 }
    return nil, 0
  }
  # request line: METHOD SP target SP version
  s := cl.start
  le := s
  while le < head_end && __load8(p + le) != 13 { le++ }
  sp1 := s
  while sp1 < le && __load8(p + sp1) != 32 { sp1++ }
  sp2 := sp1 + 1
  while sp2 < le && __load8(p + sp2) != 32 { sp2++ }
  if sp1 >= le || sp2 >= le || sp1 == s || sp2 == sp1 + 1 { return nil, 400 }
  req := &Request{method: mem_known(p + s, sp1 - s, KNOWN_METHODS, false), version: mem_known(p + sp2 + 1, le - sp2 - 1, KNOWN_METHODS, false), headers: map[str]str{}, remote_addr: cl.conn.remote_addr}
  q := sp1 + 1
  while q < sp2 && __load8(p + q) != 63 { q++ }
  req.path = mem_str(p + sp1 + 1, q - sp1 - 1)
  if q < sp2 { req.query = mem_str(p + q + 1, sp2 - q - 1) }
  # headers
  ls := le + 2
  while ls < head_end + 2 {
    e := ls
    while e < head_end && __load8(p + e) != 13 { e++ }
    colon := ls
    while colon < e && __load8(p + colon) != 58 { colon++ }
    if colon >= e || colon == ls { return nil, 400 }
    ne := colon
    while ne > ls && (__load8(p + ne - 1) == 32 || __load8(p + ne - 1) == 9) { ne-- }
    vs := colon + 1
    while vs < e && (__load8(p + vs) == 32 || __load8(p + vs) == 9) { vs++ }
    ve := e
    while ve > vs && (__load8(p + ve - 1) == 32 || __load8(p + ve - 1) == 9) { ve-- }
    req.headers[mem_known(p + ls, ne - ls, KNOWN_HEADERS, true)] = mem_str(p + vs, ve - vs)
    ls = e + 2
  }
  body_start := head_end + 4
  n := 0
  if clen, ok := req.headers["content-length"]; ok {
    v, err := strconv.atoi(clen)
    if err != nil || v < 0 { return nil, 400 }
    n = v
  } else if _, chunked := req.headers["transfer-encoding"]; chunked {
    return nil, 501
  }
  if n > MAX_BODY { return nil, 413 }
  if cl.end - body_start < n {
    # the body is still arriving: make room for it and wait
    need := body_start + n - cl.start
    keep := head_end - cl.start
    cl.in_room(need - (cl.end - cl.start))
    cl.scanned = cl.start + keep
    return nil, 0
  }
  if n > 0 { req.body = mem_str(p + body_start, n) }
  cl.start = body_start + n
  cl.scanned = cl.start
  if cl.start == cl.end {
    cl.start = 0
    cl.end = 0
    cl.scanned = 0
  }
  return req, 0
}

# should the connection stay open after answering req?
fn keep_alive(req: *Request) -> bool {
  c := req.headers["connection"]
  if req.version == "HTTP/1.1" { return !has_token(c, "close") }
  return has_token(c, "keep-alive")
}

# appends the response to the output buffer
fn (cl: *Peer) put_response(res: *Response, head_only: bool, keep: bool, http10: bool) {
  cl.put("HTTP/1.1 ")
  cl.put_int(res.status)
  cl.put(" ")
  cl.put(status_text(res.status))
  cl.put("\r\n")
  typed := false
  for k, v := range res.headers {
    if eq_fold(k, "content-length") || eq_fold(k, "connection") { continue }
    if !typed && eq_fold(k, "content-type") { typed = true }
    cl.put(k)
    cl.put(": ")
    cl.put(v)
    cl.put("\r\n")
  }
  if !typed { cl.put("Content-Type: text/plain; charset=utf-8\r\n") }
  cl.put("Content-Length: ")
  cl.put_int(res.body.n)
  if !keep { cl.put("\r\nConnection: close\r\n\r\n") } else if http10 { cl.put("\r\nConnection: keep-alive\r\n\r\n") } else { cl.put("\r\n\r\n") }
  if !head_only && res.body.n > 0 { cl.put_mem(res.body.mem + 8, res.body.n) }
}

fn error_response(code: int) -> *Response {
  res := &Response{status: code, headers: map[str]str{}}
  res.write(status_text(code) + "\n")
  return res
}

# answers every complete request in the input buffer, in order
fn (cl: *Peer) handle_input() {
  while !cl.closing {
    req, code := cl.take_request()
    if req == nil {
      if code != 0 {
        cl.put_response(error_response(code), false, false, false)
        cl.closing = true
      }
      return
    }
    cl.served++
    keep := keep_alive(req)
    if max_requests > 0 && cl.served >= max_requests { keep = false }
    res := &Response{status: 200, headers: map[str]str{}}
    h, ok := find_route(req.path)
    if !ok {
      res.status = 404
      res.write("404 page not found\n")
    } else { h(req, res) }
    cl.put_response(res, req.method == "HEAD", keep, req.version == "HTTP/1.0")
    if !keep { cl.closing = true }
  }
}

# sends what it can of the output; true when everything went out
fn (cl: *Peer) flush() -> bool {
  while cl.out_off < cl.out_n {
    w := cl.conn.write_from(cl.outb + cl.out_off, cl.out_n - cl.out_off)
    if w == -11 { return false }
    if w <= 0 {
      cl.dead = true
      return false
    }
    cl.out_off += w
  }
  cl.out_off = 0
  cl.out_n = 0
  if cl.closing { cl.dead = true }
  return true
}

# reads what arrived and answers the complete requests
fn (cl: *Peer) on_readable() {
  cl.in_room(4096)
  r := cl.conn.read_into(cl.inb + cl.end, cl.icap - cl.end)
  if r == -11 { return }
  if r <= 0 {
    # the client closed its side (or an error): nothing more will arrive
    cl.handle_input()
    cl.closing = true
    if cl.out_n == 0 { cl.dead = true }
    return
  }
  cl.end += r
  cl.handle_input()
}

let ts_buf: int = 0
fn now_ms() -> int {
  if ts_buf == 0 { ts_buf = __newstr(16) + 8 }
  __syscall(228, 1, ts_buf, 0, 0, 0, 0)          # clock_gettime(CLOCK_MONOTONIC)
  return __load64(ts_buf) * 1000 + __load64(ts_buf + 8) / 1000000
}

const LISTENER = -1

# the event loop: serves the connections of l until an error
fn serve_loop(l: *net.Listener) -> error {
  p, err := net.new_poller(512)
  if err != nil { return err }
  if p.add(l.fd, net.EV_IN, LISTENER) < 0 { return errors.New("epoll_ctl: cannot watch the listener") }
  clients := map[int]*Peer{}
  last_sweep := now_ms()
  while true {
    tick := 1000
    if idle_timeout_ms > 0 && idle_timeout_ms < 2000 { tick = idle_timeout_ms / 2 + 1 }
    n := p.wait(tick)
    if n < 0 { return errors.New("epoll_wait: error " + str(-n)) }
    t := now_ms()
    for i := 0; i < n; i++ {
      d := p.event_data(i)
      ev := p.event_flags(i)
      if d == LISTENER {
        while true {
          c, _ := l.accept_nb()
          if c == nil { break }
          c.set_nodelay()
          nc := new_peer(c)
          nc.last = t
          clients[c.fd] = nc
          p.add(c.fd, net.EV_IN | net.EV_RDHUP, c.fd)
        }
        continue
      }
      cl, ok := clients[d]
      if !ok { continue }
      cl.last = t
      if cl.waiting_out {
        if ev & (net.EV_ERR | net.EV_HUP) != 0 { cl.dead = true }
        if !cl.dead && cl.flush() {
          # everything went out: back to reading (and answer what arrived meanwhile)
          cl.waiting_out = false
          if !cl.dead {
            p.modify(cl.conn.fd, net.EV_IN | net.EV_RDHUP, cl.conn.fd)
            cl.handle_input()
          }
        }
      } else {
        cl.on_readable()
      }
      if !cl.dead && cl.out_n > 0 && !cl.waiting_out {
        if !cl.flush() && !cl.dead {
          # the socket is full: wait until it can take more, without reading meanwhile
          cl.waiting_out = true
          p.modify(cl.conn.fd, net.EV_OUT, cl.conn.fd)
        }
      }
      if cl.dead {
        p.remove(cl.conn.fd)
        delete(clients, d)
        release(cl)
      }
    }
    if idle_timeout_ms > 0 && t - last_sweep >= tick {
      last_sweep = t
      idle := []int{}
      for fd, ic := range clients { if t - ic.last >= idle_timeout_ms { idle = append(idle, fd) } }
      for _, fd := range idle {
        ic := clients[fd]
        p.remove(fd)
        delete(clients, fd)
        release(ic)
      }
    }
  }
  return nil
}

# serves one connection, blocking: one request, then the connection is closed
export fn serve_conn(c: *net.Conn) {
  cl := new_peer(c)
  while true {
    req, code := cl.take_request()
    if req != nil || code != 0 {
      if req == nil {
        cl.put_response(error_response(code), false, false, false)
      } else {
        res := &Response{status: 200, headers: map[str]str{}}
        h, ok := find_route(req.path)
        if !ok {
          res.status = 404
          res.write("404 page not found\n")
        } else { h(req, res) }
        cl.put_response(res, req.method == "HEAD", false, false)
      }
      c.write(mem_str(cl.outb, cl.out_n))
      c.close()
      return
    }
    cl.in_room(4096)
    r := c.read_into(cl.inb + cl.end, cl.icap - cl.end)
    if r <= 0 {
      c.close()
      return
    }
    cl.end += r
  }
}

# listens on host:port and serves requests forever (returns only on an error)
export fn listen_and_serve(host: str, port: int) -> error {
  l, err := net.listen_with(host, port, false, true)
  if err != nil { return err }
  return serve_loop(l)
}

# like listen_and_serve, in n processes sharing the port (n <= 0: one per CPU). The processes do
# not share memory: see the top of this file. The extra processes end when this one ends.
export fn listen_and_serve_workers(host: str, port: int, n: int) -> error {
  if n <= 0 { n = net.num_cpus() }
  # every socket of the SO_REUSEPORT group exists before any process accepts, so the kernel's
  # spreading of connections does not change while they arrive
  socks := []*net.Listener{}
  for i := 0; i < n; i++ {
    l, err := net.listen_with(host, port, true, true)
    if err != nil {
      for _, o := range socks { o.close() }
      return err
    }
    socks = append(socks, l)
  }
  if n == 1 { return serve_loop(socks[0]) }
  __flush()
  parent := os.getpid()
  for i := 1; i < n; i++ {
    pid := __syscall(57, 0, 0, 0, 0, 0, 0)                 # fork
    if pid < 0 { return errors.New("fork: error " + str(-pid)) }
    if pid == 0 {
      __syscall(157, 1, 9, 0, 0, 0, 0)                     # prctl(PR_SET_PDEATHSIG, SIGKILL)
      if __syscall(110, 0, 0, 0, 0, 0, 0) != parent { os.exit(0) }   # getppid: the parent already ended
      for j, o := range socks { if j != i { o.close() } }
      err3 := serve_loop(socks[i])
      if err3 != nil { os.eprintln(err3.Error()) }
      os.exit(1)
    }
  }
  for j := 1; j < n; j++ { socks[j].close() }
  return serve_loop(socks[0])
}

# ---------------------------------------------------------------- client
#
#   r, err := http.get("http://localhost:3800/api/produtos")
#   if err == nil && r.ok() { print(r.body) }
#   r2, err2 := http.post("http://api.local/orders", "application/json", "{\"id\":1}")
#   r3, err3 := http.request(&http.ClientRequest{method: "PUT", url: u, body: b,
#                                                  headers: map[str]str{"Authorization": "Bearer x"}})
#
# HTTP/1.1 over plain TCP: "https://" URLs are refused (there is no TLS yet). Hosts are names or
# IPv4 addresses (net.resolve). Connections are kept alive and reused for the next request to the
# same host:port; redirects are followed (up to 10); bodies come whole, by Content-Length, chunked
# or until the server closes. Each read, write and connect waits at most the request's timeout.

export struct ClientRequest {
  method: str               # "" is GET
  url: str                  # http://host[:port]/path?query
  headers: map[str]str      # sent as written; Host, Content-Length and User-Agent are added when missing
  body: str
  timeout_ms: int           # 0: the default (set_client_timeout, 30 s)
  no_redirects: bool        # give 3xx responses back instead of following them
}

export struct ClientResponse {
  status: int
  status_text: str          # the reason phrase the server sent ("OK", "Not Found"...)
  headers: map[str]str      # names in lower case; repeated headers joined with ", "
  body: str
  url: str                  # the URL that answered (after the redirects)
}

# the header value for name (any case), or ""
export fn (r: *ClientResponse) header(name: str) -> str { return r.headers[strings.to_lower(name)] }
# a 2xx status
export fn (r: *ClientResponse) ok() -> bool { return r.status >= 200 && r.status < 300 }

let client_timeout_ms: int = 30000
let user_agent: str = "caju-http/1"
# idle kept-alive connections by "host:port"
let idle_conns = map[str][]*net.Conn{}
const MAX_IDLE_PER_HOST = 8

# the timeout of requests that do not give one
export fn set_client_timeout(ms: int) { client_timeout_ms = ms }
# the User-Agent sent when a request has none
export fn set_user_agent(ua: str) { user_agent = ua }
# closes the idle kept-alive connections
export fn close_idle_connections() {
  for _, conns := range idle_conns {
    for _, c := range conns { c.close() }
  }
  idle_conns = map[str][]*net.Conn{}
}

export fn get(url: str) -> (*ClientResponse, error) {
  return request(&ClientRequest{method: "GET", url: url})
}

export fn head(url: str) -> (*ClientResponse, error) {
  return request(&ClientRequest{method: "HEAD", url: url})
}

export fn post(url: str, content_type: str, body: str) -> (*ClientResponse, error) {
  return request(&ClientRequest{method: "POST", url: url, body: body, headers: map[str]str{"Content-Type": content_type}})
}

# posts fields as application/x-www-form-urlencoded (in the order of their names)
export fn post_form(url: str, fields: map[str]str) -> (*ClientResponse, error) {
  return post(url, "application/x-www-form-urlencoded", encode_form(fields))
}

# sends a request and reads its response, following redirects unless no_redirects
export fn request(req: *ClientRequest) -> (*ClientResponse, error) {
  method := strings.to_upper(req.method)
  if method == "" { method = "GET" }
  url := req.url
  body := req.body
  timeout := req.timeout_ms
  if timeout <= 0 { timeout = client_timeout_ms }
  for hop := 0; hop <= 10; hop++ {
    res, err := round_trip(method, url, req.headers, body, timeout)
    if err != nil { return nil, err }
    loc := res.headers["location"]
    if req.no_redirects || loc == "" || (res.status != 301 && res.status != 302 && res.status != 303 && res.status != 307 && res.status != 308) {
      return res, nil
    }
    url = resolve_url(url, loc)
    # 303, and 301/302 after a POST, become a GET without body (as browsers do)
    if res.status == 303 || ((res.status == 301 || res.status == 302) && method == "POST") {
      if method != "HEAD" { method = "GET" }
      body = ""
    }
  }
  return nil, errors.New("http: " + req.url + ": too many redirects")
}

# the parts of an http URL: host, port, the request target (path and query)
fn split_url(url: str) -> (str, int, str, error) {
  rest := ""
  if strings.has_prefix(url, "http://") {
    rest = url[7:len(url)]
  } else if strings.has_prefix(url, "https://") {
    return "", 0, "", errors.New("http: " + url + ": https is not supported (std/http has no TLS yet)")
  } else {
    return "", 0, "", errors.New("http: " + url + ": not an http:// URL")
  }
  h := strings.index_byte(rest, 35)                 # drop the fragment
  if h >= 0 { rest = rest[0:h] }
  cut := len(rest)
  for i := 0; i < len(rest); i++ {
    c := int(rest[i])
    if c == 47 || c == 63 {                         # '/' or '?'
      cut = i
      break
    }
  }
  authority := rest[0:cut]
  target := rest[cut:len(rest)]
  if target == "" || int(target[0]) == 63 { target = "/" + target }
  if strings.index_byte(authority, 64) >= 0 { return "", 0, "", errors.New("http: " + url + ": user info in URLs is not supported (send an Authorization header)") }
  host := authority
  port := 80
  colon := strings.last_index(authority, ":")
  if colon >= 0 {
    host = authority[0:colon]
    p, err := strconv.atoi(authority[colon + 1:len(authority)])
    if err != nil || p <= 0 || p > 65535 { return "", 0, "", errors.New("http: " + url + ": invalid port") }
    port = p
  }
  if host == "" { return "", 0, "", errors.New("http: " + url + ": no host") }
  return host, port, target, nil
}

# a Location header made absolute against the URL that sent it
fn resolve_url(base: str, loc: str) -> str {
  if strings.has_prefix(loc, "http://") || strings.has_prefix(loc, "https://") { return loc }
  if strings.has_prefix(loc, "//") { return "http:" + loc }
  rest := base[7:len(base)]
  slash := strings.index_byte(rest, 47)
  origin := "http://" + rest
  path := "/"
  if slash >= 0 {
    origin = "http://" + rest[0:slash]
    path = rest[slash:len(rest)]
  }
  if strings.has_prefix(loc, "/") { return origin + loc }
  q := strings.index_byte(path, 63)
  if q >= 0 { path = path[0:q] }
  if strings.has_prefix(loc, "?") { return origin + path + loc }
  dir := path[0:strings.last_index(path, "/") + 1]
  return origin + dir + loc
}

# one request on a kept-alive connection or a new one; a reused connection the server had
# already closed is replaced once
fn round_trip(method: str, url: str, headers: map[str]str, body: str, timeout: int) -> (*ClientResponse, error) {
  host, port, target, err := split_url(url)
  if err != nil { return nil, err }
  key := host + ":" + str(port)
  msg := request_text(method, host, port, target, headers, body)
  for attempt := 0; attempt < 2; attempt++ {
    c, reused := take_idle(key)
    if c == nil {
      nc, derr := net.dial_timeout(host, port, timeout)
      if derr != nil { return nil, errors.New("http: " + derr.Error()) }
      c = nc
    }
    c.set_timeout(timeout)
    werr := c.write(msg)
    if werr != nil {
      c.close()
      if reused { continue }
      return nil, errors.New("http: " + key + ": " + werr.Error())
    }
    res, got, keep, rerr := read_reply(c, method)
    if rerr != nil {
      c.close()
      # nothing came back on a reused connection: the server closed it, try a new one
      if reused && !got { continue }
      return nil, errors.New("http: " + key + ": " + rerr.Error())
    }
    res.url = url
    if keep { put_idle(key, c) } else { c.close() }
    return res, nil
  }
  return nil, errors.New("http: " + key + ": the connection was closed")
}

fn take_idle(key: str) -> (*net.Conn, bool) {
  conns := idle_conns[key]
  while len(conns) > 0 {
    c := conns[len(conns) - 1]
    conns = conns[0:len(conns) - 1]
    idle_conns[key] = conns
    # readable while idle: closed by the server (or it sent something unasked)
    if !c.readable() { return c, true }
    c.close()
  }
  return nil, false
}

fn put_idle(key: str, c: *net.Conn) {
  conns := idle_conns[key]
  if len(conns) >= MAX_IDLE_PER_HOST {
    c.close()
    return
  }
  idle_conns[key] = append(conns, c)
}

fn has_header(headers: map[str]str, name: str) -> bool {
  for k, _ := range headers {
    if eq_fold(k, name) { return true }
  }
  return false
}

fn request_text(method: str, host: str, port: int, target: str, headers: map[str]str, body: str) -> str {
  b := strings.Builder{}
  b.write(method)
  b.write(" ")
  b.write(target)
  b.write(" HTTP/1.1\r\n")
  if !has_header(headers, "host") {
    b.write("Host: ")
    b.write(host)
    if port != 80 { b.write(":" + str(port)) }
    b.write("\r\n")
  }
  if !has_header(headers, "user-agent") { b.write("User-Agent: " + user_agent + "\r\n") }
  if !has_header(headers, "content-length") && (len(body) > 0 || method == "POST" || method == "PUT" || method == "PATCH") {
    b.write("Content-Length: " + str(len(body)) + "\r\n")
  }
  for _, k := range sorted_keys(headers) {
    b.write(k)
    b.write(": ")
    b.write(headers[k])
    b.write("\r\n")
  }
  b.write("\r\n")
  b.write(body)
  return b.string()
}

fn sorted_keys(m: map[str]str) -> []str {
  keys := []str{}
  for k, _ := range m { keys = append(keys, k) }
  for i := 1; i < len(keys); i++ {
    k := keys[i]
    j := i - 1
    while j >= 0 && keys[j] > k {
      keys[j + 1] = keys[j]
      j--
    }
    keys[j + 1] = k
  }
  return keys
}

# reads the bytes of a response as they arrive
struct Reader {
  conn: *net.Conn
  buf: str
  pos: int
  got: bool       # something arrived
  eof: bool
}

fn (r: *Reader) fill() -> error {
  if r.eof { return errors.New("unexpected end of the response") }
  chunk, err := r.conn.read(65536)
  if err != nil { return err }
  if chunk == "" {
    r.eof = true
    return errors.New("the connection was closed before the response")
  }
  r.got = true
  if r.pos > 0 {
    r.buf = r.buf[r.pos:len(r.buf)]
    r.pos = 0
  }
  r.buf = r.buf + chunk
  return nil
}

# a line without its CRLF
fn (r: *Reader) line() -> (str, error) {
  while true {
    nl := strings.index_from(r.buf, "\n", r.pos)
    if nl >= 0 {
      s := r.buf[r.pos:nl]
      r.pos = nl + 1
      return strings.trim_suffix(s, "\r"), nil
    }
    if len(r.buf) - r.pos > 65536 { return "", errors.New("header line too long") }
    err := r.fill()
    if err != nil { return "", err }
  }
  return "", nil
}

# exactly n bytes
fn (r: *Reader) take(n: int) -> (str, error) {
  while len(r.buf) - r.pos < n {
    err := r.fill()
    if err != nil { return "", err }
  }
  s := r.buf[r.pos:r.pos + n]
  r.pos += n
  return s, nil
}

# everything until the server closes
fn (r: *Reader) rest() -> (str, error) {
  b := strings.Builder{}
  b.write(r.buf[r.pos:len(r.buf)])
  r.buf = ""
  r.pos = 0
  while true {
    chunk, err := r.conn.read(65536)
    if err != nil { return "", err }
    if chunk == "" { break }
    b.write(chunk)
  }
  r.eof = true
  return b.string(), nil
}

# reads one response: it, whether any byte arrived, whether the connection can be kept
fn read_reply(c: *net.Conn, method: str) -> (*ClientResponse, bool, bool, error) {
  r := &Reader{conn: c}
  while true {
    status_line, err := r.line()
    if err != nil { return nil, r.got, false, err }
    if status_line == "" { continue }
    parts := strings.split(status_line, " ")
    if len(parts) < 2 || !strings.has_prefix(parts[0], "HTTP/") { return nil, true, false, errors.New("malformed status line \"" + status_line + "\"") }
    status, serr := strconv.atoi(parts[1])
    if serr != nil { return nil, true, false, errors.New("malformed status line \"" + status_line + "\"") }
    res := &ClientResponse{status: status, headers: map[str]str{}}
    if len(parts) > 2 { res.status_text = strings.join(parts[2:len(parts)], " ") }
    while true {
      hl, herr := r.line()
      if herr != nil { return nil, true, false, herr }
      if hl == "" { break }
      colon := strings.index_byte(hl, 58)
      if colon <= 0 { continue }
      name := strings.to_lower(strings.trim_space(hl[0:colon]))
      value := strings.trim_space(hl[colon + 1:len(hl)])
      prev, seen := res.headers[name]
      if seen { res.headers[name] = prev + ", " + value } else { res.headers[name] = value }
    }
    if status >= 100 && status < 200 { continue }    # 100 Continue and friends: the real one follows
    keep := parts[0] == "HTTP/1.1" && !has_token(strings.to_lower(res.headers["connection"]), "close")
    if parts[0] == "HTTP/1.0" && has_token(strings.to_lower(res.headers["connection"]), "keep-alive") { keep = true }
    if method == "HEAD" || status == 204 || status == 304 { return res, true, keep && r.pos == len(r.buf), nil }
    te := strings.to_lower(res.headers["transfer-encoding"])
    if te != "" && te != "identity" {
      if !strings.has_suffix(te, "chunked") { return nil, true, false, errors.New("unsupported Transfer-Encoding \"" + te + "\"") }
      body, cerr := read_chunked(r)
      if cerr != nil { return nil, true, false, cerr }
      res.body = body
    } else if res.headers["content-length"] != "" {
      n, nerr := strconv.atoi(res.headers["content-length"])
      if nerr != nil || n < 0 { return nil, true, false, errors.New("invalid Content-Length") }
      body, berr := r.take(n)
      if berr != nil { return nil, true, false, berr }
      res.body = body
    } else {
      body, berr := r.rest()
      if berr != nil { return nil, true, false, berr }
      res.body = body
      keep = false
    }
    return res, true, keep && r.pos == len(r.buf), nil
  }
  return nil, false, false, nil
}

fn read_chunked(r: *Reader) -> (str, error) {
  b := strings.Builder{}
  while true {
    size_line, err := r.line()
    if err != nil { return "", err }
    semi := strings.index_byte(size_line, 59)        # chunk extensions
    if semi >= 0 { size_line = size_line[0:semi] }
    n, perr := strconv.parse_int(strings.trim_space(size_line), 16)
    if perr != nil || n < 0 { return "", errors.New("invalid chunk size \"" + size_line + "\"") }
    if n == 0 {
      while true {                                    # trailers, up to the empty line
        t, terr := r.line()
        if terr != nil { return "", terr }
        if t == "" { break }
      }
      return b.string(), nil
    }
    data, derr := r.take(n)
    if derr != nil { return "", derr }
    b.write(data)
    _, lerr := r.line()
    if lerr != nil { return "", lerr }
  }
  return "", nil
}

# ---------------------------------------------------------------- URL encoding

# s with every byte but letters, digits and -_.~ written as %XX (a query value or path segment)
export fn query_escape(s: str) -> str {
  hexd := "0123456789ABCDEF"
  b := strings.Builder{}
  for i := 0; i < len(s); i++ {
    c := int(s[i])
    if (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 45 || c == 95 || c == 46 || c == 126 {
      b.write_byte(c)
    } else {
      b.write_byte(37)
      b.write_byte(int(hexd[c >> 4]))
      b.write_byte(int(hexd[c & 15]))
    }
  }
  return b.string()
}

fn hex_val(c: int) -> int {
  if c >= 48 && c <= 57 { return c - 48 }
  if c >= 97 && c <= 102 { return c - 87 }
  if c >= 65 && c <= 70 { return c - 55 }
  return -1
}

# undoes query_escape; "+" becomes a space (forms); a malformed %XX stays as it is
export fn query_unescape(s: str) -> str {
  if strings.index_byte(s, 37) < 0 && strings.index_byte(s, 43) < 0 { return s }
  b := strings.Builder{}
  i := 0
  while i < len(s) {
    c := int(s[i])
    if c == 43 {
      b.write_byte(32)
    } else if c == 37 && i + 2 < len(s) && hex_val(int(s[i + 1])) >= 0 && hex_val(int(s[i + 2])) >= 0 {
      b.write_byte(hex_val(int(s[i + 1])) * 16 + hex_val(int(s[i + 2])))
      i += 2
    } else {
      b.write_byte(c)
    }
    i++
  }
  return b.string()
}

# fields as "a=1&b=2" (names in order, values escaped)
export fn encode_form(fields: map[str]str) -> str {
  parts := []str{}
  for _, k := range sorted_keys(fields) { parts = append(parts, query_escape(k) + "=" + query_escape(fields[k])) }
  return strings.join(parts, "&")
}

# "a=1&b=x%20y" as a map (the last value of a repeated name wins)
export fn parse_form(s: str) -> map[str]str {
  m := map[str]str{}
  for _, part := range strings.split(s, "&") {
    if part == "" { continue }
    eq := strings.index_byte(part, 61)
    if eq < 0 { m[query_unescape(part)] = "" } else { m[query_unescape(part[0:eq])] = query_unescape(part[eq + 1:len(part)]) }
  }
  return m
}
