# A server that answers with raw bytes, for what std/http's own server never sends (chunked
# bodies, bodies until the connection closes, 100 Continue, HTTP/1.0). PORT; one connection at
# a time; the path picks the reply.
import "std/net"
import "std/os"
import "std/strings"
import "std/strconv"

fn reply_for(path: str) -> (str, bool) {
  switch path {
  case "/chunked":
    return "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nX-A: 1\r\nx-a: 2\r\n\r\n5;ext=1\r\nhello\r\n7\r\n, caju!\r\n0\r\nX-Trailer: t\r\n\r\n", true
  case "/close":
    return "HTTP/1.1 200 OK\r\nConnection: close\r\n\r\nuntil the end", false
  case "/continue":
    return "HTTP/1.1 100 Continue\r\n\r\nHTTP/1.1 200 Fine Thanks\r\nContent-Length: 2\r\n\r\nok", true
  case "/old":
    return "HTTP/1.0 200 OK\r\nContent-Length: 3\r\n\r\nold", false
  case "/slow":
    os.run([]str{"sleep", "2"}, nil, true)
    return "HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\nlate", true
  }
  return "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n", true
}

port, _ := strconv.atoi(os.getenv("PORT"))
l, err := net.listen("127.0.0.1", port)
if err != nil {
  os.eprintln(err.Error())
  os.exit(1)
}
while true {
  c, aerr := l.accept()
  if aerr != nil { continue }
  buf := ""
  while true {
    he := strings.index(buf, "\r\n\r\n")
    if he < 0 {
      chunk, rerr := c.read(4096)
      if rerr != nil || chunk == "" { break }
      buf = buf + chunk
      continue
    }
    line := buf[0:strings.index(buf, "\r\n")]
    buf = buf[he + 4:len(buf)]
    path := strings.split(line, " ")[1]
    out, keep := reply_for(path)
    c.write(out)
    if !keep { break }
  }
  c.close()
}
