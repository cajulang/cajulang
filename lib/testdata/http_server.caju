# The server the tests of std/http talk to: PORT, IDLE_MS (idle timeout), WORKERS.
import "std/http"
import "std/os"
import "std/strconv"

http.handle("/", fn(req: *http.Request, res: *http.Response) {
  res.set_header("content-type", "text/plain")
  res.write(req.method + " " + req.path + " q=" + req.query + " body=" + str(len(req.body)) + " pid=" + str(os.getpid()))
})
http.handle("/echo", fn(req: *http.Request, res: *http.Response) { res.write(req.body) })
http.handle("/from", fn(req: *http.Request, res: *http.Response) { res.write(req.remote_addr) })
http.handle("/api/", fn(req: *http.Request, res: *http.Response) { res.write("api " + req.path) })
http.handle("/api/v2/", fn(req: *http.Request, res: *http.Response) { res.write("v2 " + req.path) })
http.handle("/files/", fn(req: *http.Request, res: *http.Response) { res.write("files old") })
http.handle("/files/", fn(req: *http.Request, res: *http.Response) { res.write("files " + req.path) })
http.handle("/hdr", fn(req: *http.Request, res: *http.Response) { res.write(req.header("X-Custom") + "|" + req.header("x-custom") + "|" + req.header("HOST")) })
http.handle("/redirect", fn(req: *http.Request, res: *http.Response) {
  res.set_status(302)
  res.set_header("Location", "/echo-method?" + req.query)
})
http.handle("/see-other", fn(req: *http.Request, res: *http.Response) {
  res.set_status(303)
  res.set_header("Location", "http://localhost:" + os.getenv("PORT") + "/echo-method")
})
http.handle("/keep", fn(req: *http.Request, res: *http.Response) {
  res.set_status(307)
  res.set_header("Location", "echo-method")
})
http.handle("/loop", fn(req: *http.Request, res: *http.Response) {
  res.set_status(302)
  res.set_header("Location", "/loop")
})
http.handle("/echo-method", fn(req: *http.Request, res: *http.Response) { res.write(req.method + " " + req.query + " " + req.body) })
http.handle("/headers", fn(req: *http.Request, res: *http.Response) {
  res.set_header("X-Got", req.header("authorization") + "|" + req.header("user-agent") + "|" + req.header("content-type"))
  res.set_status(201)
})
http.handle("/missing", fn(req: *http.Request, res: *http.Response) {
  res.set_status(404)
  res.write("nope")
})
port, _ := strconv.atoi(os.getenv("PORT"))
idle, _ := strconv.atoi(os.getenv("IDLE_MS"))
if idle > 0 { http.set_idle_timeout(idle) }
workers, _ := strconv.atoi(os.getenv("WORKERS"))
let err: error
if workers > 0 { err = http.listen_and_serve_workers("127.0.0.1", port, workers) } else { err = http.listen_and_serve("127.0.0.1", port) }
if err != nil {
  os.eprintln(err.Error())
  os.exit(1)
}
