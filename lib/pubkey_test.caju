import "std/pubkey"
import "std/hex"
import "std/strings"
import { describe, it, expect } from "std/testing"

# Keys (DER SubjectPublicKeyInfo) and signatures made with OpenSSL 3.0 over MSG:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 (3072, 4096, 1024), RSA-PSS,
#     EC -pkeyopt ec_paramgen_curve:P-256 (P-384), ED25519; openssl pkey -pubout -outform DER
#   openssl dgst -sha256 -sign key.pem [-sigopt rsa_padding_mode:pss -sigopt rsa_pss_saltlen:N
#     -sigopt rsa_mgf1_md:sha256] msg.txt; Ed25519: openssl pkeyutl -sign -rawin

fn unhex(s: str) -> str {
  b, err := hex.decode(s)
  if err != nil { panic(err) }
  return b
}

# a DER element (tag, definite length, contents)
fn tlv(tag: int, c: str) -> str {
  n := len(c)
  l := ""
  if n < 0x80 {
    l = chr2(n)
  } else if n < 0x100 {
    l = chr2(0x81) + chr2(n)
  } else {
    l = chr2(0x82) + chr2(n >> 8) + chr2(n & 255)
  }
  return chr2(tag) + l + c
}

# one byte as a binary string
fn chr2(b: int) -> str {
  return unhex(hexbyte(b))
}

fn hexbyte(b: int) -> str {
  digits := "0123456789abcdef"
  return digits[(b >> 4) & 15:((b >> 4) & 15) + 1] + digits[b & 15:(b & 15) + 1]
}

# s with bit 0 of byte i flipped
fn flip(s: str, i: int) -> str {
  return s[0:i] + chr2(int(s[i]) ^ 1) + s[i + 1:len(s)]
}

