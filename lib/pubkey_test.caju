  "735b42499ce4053e35f9511a3fb6db9fb1711b667b8ccb70d61d4a3b86693012732dd32d261d4f8e3f573d0b6a6f4e14",
  "ca3bbc7ee2ff3fa82f0ae166f757dc478414fe0ec0e48a8e663bea9cf22be4c455f2026b307e3a8db49a40954389b6c0",
  "64ee86fa731233870947edf397f922d510195c230a8a07a384403c2bc6c43a94e4afbad2cbb6f90f745c5b287970ec02",
  "9b7f575ca293c99e2d0e244ed574e1bc6e553e310a57d1e3b204246cb65acce300f365fc30f8b37f7151aa945128636a",
  "2a055a77798ad36236dd313fac789c20587aaee35d35d8689f1d740b9349aaf58fdd24310055afcff69535c843ecb595",
  "ab73c23f22f3afe5a0830f5446607a32"}, ""))
let SIG_RSA1024 = unhex(strings.join([]str{
  "2acb40f52dbbd3bbc6df01d75eca3c3f5c06e99e80e2fc8782676cc1055ab28badb500f919132ad654a078f5e8b67ace",
  "377f7bc3a3f78ad9e2a237cb6e6dd42edd333e6a24034056946ab075c1e433ab656fba1483ac35d94dd6e58dc50a497d",
  "940732860087eb50b03edd065f7af44dca9dccef32a1e6d05537eaf8204edec2"}, ""))
let SIG_P256_SHA256 = unhex(strings.join([]str{
  "3046022100c640464330d9b2db4332af37df4c625b4ea1595fe180723cc255e4e7155c2a8d022100db7d719c3ce18b6e",
  "a30c44cc85ffe3977ae1ac2d525d5f638b01cd272b83ee47"}, ""))
let SIG_P256_SHA384 = unhex(strings.join([]str{
  "304402207aca9c02bcf0f9112f9b7523466270f46cd7bf11dbfddc0dc41ce3f4b48ac2270220713c28fe47b059919497",
  "dd698a84da77d3e8f16af1cc216fc88c947eae912a09"}, ""))
let SIG_P384_SHA384 = unhex(strings.join([]str{
  "3066023100c4315c16648a9e3ef4139d84e83749d238fe7f67ea0d59115631a29e41aede0fe552c5e61b9136ca01b594",
  "2963081e70023100f277c20e58bcdc2a26bcfb2be318ad04063994ed76c17ba0d3786cd6e6ea40ebf7fb42a1c9c27668",
  "a47a2f1c3ba5fd86"}, ""))
let SIG_P384_SHA256 = unhex(strings.join([]str{
  "306502305fc4c022dfb35599008ae45790e65937e1071bc60f2364ab9503f2bb22e1dee609993952a1052cfe60c7b9fa",
  "9093ba4f023100b01ec578908c252ae3012cf6be85d053f7ecd31ccb89bdff567172c6276c7049ee4ad192ec11139920",
  "c6d5e9f59c5f91"}, ""))
let SIG_ED25519 = unhex(strings.join([]str{
  "3e6ce9f5ff3065c50d0782cc57689e58d93f5365e07d70d49b5c3ee8c407c9fa5714a459ee5cb6e9090bf7873d533f79",
  "40e1e1a068f516b79d2727de41b1d205"}, ""))

# every algorithm: a valid signature, and the same with one bit flipped in the message and in
# the signature
struct Case {
  alg: str
  key: str
  sig: str
}

let CASES = []Case{
  Case{"rsa-pkcs1-sha256", RSA2048, SIG_PKCS1_SHA256},
  Case{"rsa-pkcs1-sha384", RSA2048, SIG_PKCS1_SHA384},
  Case{"rsa-pkcs1-sha512", RSA2048, SIG_PKCS1_SHA512},
  Case{"rsa-pkcs1-sha1", RSA2048, SIG_PKCS1_SHA1},
  Case{"rsa-pkcs1-sha256", RSA4096, SIG_PKCS1_4096},
  Case{"rsa-pss-sha256", RSA3072, SIG_PSS_SALT32},
  Case{"rsa-pss-sha256", RSA3072, SIG_PSS_SALT0},
  Case{"rsa-pss-sha256", RSA3072, SIG_PSS_SALT64},
  Case{"rsa-pss-sha512", RSA3072, SIG_PSS_SHA512},
  Case{"rsa-pss-sha384", RSA4096, SIG_PSS_SHA384_4096},
  Case{"rsa-pss-sha256", RSA_PSS_KEY, SIG_PSS_KEY},
  Case{"ecdsa-p256-sha256", P256, SIG_P256_SHA256},
  Case{"ecdsa-p256-sha384", P256, SIG_P256_SHA384},
  Case{"ecdsa-p384-sha384", P384, SIG_P384_SHA384},
  Case{"ecdsa-p384-sha256", P384, SIG_P384_SHA256},
  Case{"ed25519", ED25519, SIG_ED25519}}

describe("pubkey.verify_signature", fn() {
  for _, c := range CASES {
    alg := c.alg
    key := c.key
    sig := c.sig
    title := alg + " (" + str(len(sig)) + "-byte signature)"
    it("accepts a valid " + title, fn() {
      expect(pubkey.verify_signature(alg, key, MSG, sig)).to_be_nil()
    })
    it("refuses " + title + " with a flipped bit in the message", fn() {
      expect(pubkey.verify_signature(alg, key, flip(MSG, 3), sig)).not_().to_be_nil()
    })
    it("refuses " + title + " with a flipped bit in the signature", fn() {
      expect(pubkey.verify_signature(alg, key, MSG, flip(sig, len(sig) - 5))).not_().to_be_nil()
      expect(pubkey.verify_signature(alg, key, MSG, flip(sig, len(sig) / 2))).not_().to_be_nil()
    })
  }
  it("accepts PSS signatures with salt lengths 0, 32 and 64", fn() {
    expect(pubkey.verify_signature("rsa-pss-sha256", RSA3072, MSG, SIG_PSS_SALT0)).to_be_nil()
    expect(pubkey.verify_signature("rsa-pss-sha256", RSA3072, MSG, SIG_PSS_SALT32)).to_be_nil()
    expect(pubkey.verify_signature("rsa-pss-sha256", RSA3072, MSG, SIG_PSS_SALT64)).to_be_nil()
  })
  it("refuses a PKCS #1 v1.5 signature checked as PSS and the reverse", fn() {
    expect(pubkey.verify_signature("rsa-pss-sha256", RSA2048, MSG, SIG_PKCS1_SHA256)).not_().to_be_nil()
    expect(pubkey.verify_signature("rsa-pkcs1-sha256", RSA3072, MSG, SIG_PSS_SALT32)).not_().to_be_nil()
  })
  it("refuses a signature checked with another hash", fn() {
    expect(pubkey.verify_signature("rsa-pkcs1-sha384", RSA2048, MSG, SIG_PKCS1_SHA256)).not_().to_be_nil()
    expect(pubkey.verify_signature("rsa-pss-sha384", RSA3072, MSG, SIG_PSS_SALT32)).not_().to_be_nil()
    expect(pubkey.verify_signature("ecdsa-p256-sha384", P256, MSG, SIG_P256_SHA256)).not_().to_be_nil()
  })
  it("refuses an RSA signature of the wrong size", fn() {
    expect(pubkey.verify_signature("rsa-pkcs1-sha256", RSA2048, MSG, SIG_PKCS1_SHA256[1:256])).to_be_error("pubkey: RSA signature has the wrong size")
    expect(pubkey.verify_signature("rsa-pkcs1-sha256", RSA2048, MSG, unhex("00") + SIG_PKCS1_SHA256)).to_be_error("pubkey: RSA signature has the wrong size")
  })
  it("refuses an RSA signature not below the modulus", fn() {
    sig := unhex(strings.repeat("ff", 256))
    expect(pubkey.verify_signature("rsa-pkcs1-sha256", RSA2048, MSG, sig)).to_be_error("pubkey: RSA signature out of range")
  })
  it("refuses an empty or garbage signature", fn() {
    for _, c := range CASES {
      expect(pubkey.verify_signature(c.alg, c.key, MSG, "")).not_().to_be_nil()
      expect(pubkey.verify_signature(c.alg, c.key, MSG, "garbage")).not_().to_be_nil()
    }
  })
})

describe("pubkey.verify_signature key checks", fn() {
  it("refuses a key of another type than the algorithm", fn() {
    msg := "pubkey: key does not match the signature algorithm "
    expect(pubkey.verify_signature("ecdsa-p256-sha256", RSA2048, MSG, SIG_PKCS1_SHA256)).to_be_error(msg + "ecdsa-p256-sha256")
    expect(pubkey.verify_signature("rsa-pkcs1-sha256", P256, MSG, SIG_P256_SHA256)).to_be_error(msg + "rsa-pkcs1-sha256")
    expect(pubkey.verify_signature("ecdsa-p384-sha256", P256, MSG, SIG_P256_SHA256)).to_be_error(msg + "ecdsa-p384-sha256")
    expect(pubkey.verify_signature("ecdsa-p256-sha384", P384, MSG, SIG_P384_SHA384)).to_be_error(msg + "ecdsa-p256-sha384")
    expect(pubkey.verify_signature("ed25519", RSA2048, MSG, SIG_ED25519)).to_be_error(msg + "ed25519")
    expect(pubkey.verify_signature("rsa-pss-sha256", ED25519, MSG, SIG_ED25519)).to_be_error(msg + "rsa-pss-sha256")
  })
  it("refuses an id-RSASSA-PSS key for PKCS #1 v1.5", fn() {
    expect(pubkey.verify_signature("rsa-pkcs1-sha256", RSA_PSS_KEY, MSG, SIG_PSS_KEY)).to_be_error("pubkey: key does not match the signature algorithm rsa-pkcs1-sha256")
  })
  it("refuses an unknown algorithm", fn() {
    expect(pubkey.verify_signature("rsa-pkcs1-md5", RSA2048, MSG, SIG_PKCS1_SHA256)).to_be_error("pubkey: unsupported signature algorithm rsa-pkcs1-md5")
    expect(pubkey.verify_signature("", RSA2048, MSG, SIG_PKCS1_SHA256)).not_().to_be_nil()
  })
  it("refuses a 1024-bit RSA key, even with a valid signature", fn() {
    expect(pubkey.verify_signature("rsa-pkcs1-sha256", RSA1024, MSG, SIG_RSA1024)).to_be_error("pubkey: RSA key of 1024 bits is too small")
    expect(pubkey.verify_signature("rsa-pkcs1-sha1", RSA1024, MSG, SIG_RSA1024)).to_be_error("pubkey: RSA key of 1024 bits is too small")
  })
  it("refuses an RSA key above 16384 bits", fn() {
    n := unhex("00" + strings.repeat("ff", 2049))
    key := tlv(0x30, tlv(0x30, tlv(0x06, unhex("2a864886f70d010101")) + tlv(0x05, "")) + tlv(0x03, unhex("00") + tlv(0x30, tlv(0x02, n) + tlv(0x02, unhex("010001")))))
    kind, bits, err := pubkey.key_info(key)
    expect(err).to_be_nil()
    expect(kind).to_equal("rsa")
    expect(bits).to_equal(16392)
    expect(pubkey.verify_signature("rsa-pkcs1-sha256", key, MSG, SIG_PKCS1_SHA256)).to_be_error("pubkey: RSA key of 16392 bits is too large")
  })
  it("refuses an RSA key with an even modulus or exponent", fn() {
    n := unhex("00" + strings.repeat("ff", 255) + "fe")
    key := tlv(0x30, tlv(0x30, tlv(0x06, unhex("2a864886f70d010101")) + tlv(0x05, "")) + tlv(0x03, unhex("00") + tlv(0x30, tlv(0x02, n) + tlv(0x02, unhex("010001")))))
    _, _, err := pubkey.key_info(key)
    expect(err).to_be_error("pubkey: bad RSA modulus")
    n = unhex("00" + strings.repeat("ff", 256))
    key = tlv(0x30, tlv(0x30, tlv(0x06, unhex("2a864886f70d010101")) + tlv(0x05, "")) + tlv(0x03, unhex("00") + tlv(0x30, tlv(0x02, n) + tlv(0x02, unhex("010000")))))
    _, _, err = pubkey.key_info(key)
    expect(err).to_be_error("pubkey: bad RSA exponent")
  })
  it("refuses an ECDSA public key that is not on the curve", fn() {
    bad := flip(P256, len(P256) - 1)
    expect(pubkey.verify_signature("ecdsa-p256-sha256", bad, MSG, SIG_P256_SHA256)).to_be_error("pubkey: EC point is not on the curve")
    bad = flip(P384, len(P384) - 10)
    _, _, err := pubkey.key_info(bad)
    expect(err).to_be_error("pubkey: EC point is not on the curve")
  })
  it("refuses an ECDSA public key with a coordinate not below p", fn() {
    # x = p, y = 0 (y^2 = p^3 - 3p + b = b != 0 anyway, but the range check comes first)
    point := unhex("04ffffffff00000001000000000000000000000000ffffffffffffffffffffffff" + strings.repeat("00", 32))
    key := P256[0:len(P256) - 65] + point
    expect(pubkey.verify_signature("ecdsa-p256-sha256", key, MSG, SIG_P256_SHA256)).to_be_error("pubkey: EC point is not on the curve")
  })
  it("refuses a compressed or wrongly sized ECDSA point", fn() {
    key := P256[0:len(P256) - 65] + unhex("02") + P256[len(P256) - 64:len(P256)]
    expect(pubkey.verify_signature("ecdsa-p256-sha256", key, MSG, SIG_P256_SHA256)).to_be_error("pubkey: only uncompressed EC points are supported")
  })
})

# the r and s of the P-256 test signature; both have the top bit set, so DER puts a 0x00 before
let P256_R = SIG_P256_SHA256[4:37]
let P256_S = SIG_P256_SHA256[39:72]
let P256_N = unhex("ffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551")

describe("pubkey ECDSA signature encoding", fn() {
  it("accepts r and s whose DER integers carry a leading zero byte", fn() {
    expect(hex.encode(P256_R[0:1])).to_equal("00")
    expect(hex.encode(P256_S[0:1])).to_equal("00")
    sig := tlv(0x30, tlv(0x02, P256_R) + tlv(0x02, P256_S))
    expect(sig).to_equal(SIG_P256_SHA256)
    expect(pubkey.verify_signature("ecdsa-p256-sha256", P256, MSG, sig)).to_be_nil()
  })
  it("refuses a non-minimal integer (an extra leading zero)", fn() {
    sig := tlv(0x30, tlv(0x02, unhex("00") + P256_R) + tlv(0x02, P256_S))
    expect(pubkey.verify_signature("ecdsa-p256-sha256", P256, MSG, sig)).to_be_error("pubkey: non-minimal DER integer")
  })
  it("refuses a negative integer (the leading zero dropped)", fn() {
    sig := tlv(0x30, tlv(0x02, P256_R[1:33]) + tlv(0x02, P256_S))
    expect(pubkey.verify_signature("ecdsa-p256-sha256", P256, MSG, sig)).to_be_error("pubkey: negative DER integer")
  })
  it("refuses s >= n", fn() {
    sig := tlv(0x30, tlv(0x02, P256_R) + tlv(0x02, unhex("00") + P256_N))
    expect(pubkey.verify_signature("ecdsa-p256-sha256", P256, MSG, sig)).to_be_error("pubkey: ECDSA signature out of range")
    sig = tlv(0x30, tlv(0x02, P256_R) + tlv(0x02, unhex("00") + strings.repeat(unhex("ff"), 32)))
    expect(pubkey.verify_signature("ecdsa-p256-sha256", P256, MSG, sig)).to_be_error("pubkey: ECDSA signature out of range")
    sig = tlv(0x30, tlv(0x02, P256_R) + tlv(0x02, unhex("01") + strings.repeat(unhex("00"), 32)))
    expect(pubkey.verify_signature("ecdsa-p256-sha256", P256, MSG, sig)).to_be_error("pubkey: ECDSA signature out of range")
  })
  it("refuses r = 0 and s = 0", fn() {
    sig := tlv(0x30, tlv(0x02, unhex("00")) + tlv(0x02, P256_S))
    expect(pubkey.verify_signature("ecdsa-p256-sha256", P256, MSG, sig)).to_be_error("pubkey: ECDSA signature out of range")
    sig = tlv(0x30, tlv(0x02, P256_R) + tlv(0x02, unhex("00")))
    expect(pubkey.verify_signature("ecdsa-p256-sha256", P256, MSG, sig)).to_be_error("pubkey: ECDSA signature out of range")
  })
  it("refuses a signature with r and s swapped", fn() {
    sig := tlv(0x30, tlv(0x02, P256_S) + tlv(0x02, P256_R))
    expect(pubkey.verify_signature("ecdsa-p256-sha256", P256, MSG, sig)).to_be_error("pubkey: invalid ECDSA signature")
  })
  it("refuses trailing data after the signature and inside it", fn() {
    expect(pubkey.verify_signature("ecdsa-p256-sha256", P256, MSG, SIG_P256_SHA256 + unhex("00"))).to_be_error("pubkey: trailing data after DER")
    sig := tlv(0x30, tlv(0x02, P256_R) + tlv(0x02, P256_S) + tlv(0x02, unhex("01")))
    expect(pubkey.verify_signature("ecdsa-p256-sha256", P256, MSG, sig)).to_be_error("pubkey: trailing data in ECDSA signature")
  })
  it("refuses a truncated signature", fn() {
    expect(pubkey.verify_signature("ecdsa-p256-sha256", P256, MSG, SIG_P256_SHA256[0:len(SIG_P256_SHA256) - 1])).to_be_error("pubkey: truncated DER")
  })
})

describe("pubkey malformed DER", fn() {
  it("returns an error for a truncated key at every length", fn() {
    for _, key := range []str{RSA2048, P256, P384, ED25519} {
      i := 0
      while i < len(key) {
        _, _, err := pubkey.key_info(key[0:i])
        expect(err).not_().to_be_nil()
        expect(pubkey.verify_signature("ecdsa-p256-sha256", key[0:i], MSG, SIG_P256_SHA256)).not_().to_be_nil()
        i++
      }
    }
  })
  it("returns an error for trailing bytes after the key", fn() {
    _, _, err := pubkey.key_info(P256 + unhex("00"))
    expect(err).to_be_error("pubkey: trailing data after DER")
    expect(pubkey.verify_signature("rsa-pkcs1-sha256", RSA2048 + unhex("0500"), MSG, SIG_PKCS1_SHA256)).to_be_error("pubkey: trailing data after DER")
  })
  it("returns an error for a huge length", fn() {
    _, _, err := pubkey.key_info(unhex("30847fffffff3000"))
    expect(err).to_be_error("pubkey: truncated DER")
    _, _, err = pubkey.key_info(unhex("3088ffffffffffffffff00"))
    expect(err).to_be_error("pubkey: DER length too large")
    _, _, err = pubkey.key_info(unhex("3084ffffffff00"))
    expect(err).to_be_error("pubkey: truncated DER")
  })
  it("returns an error for indefinite and non-minimal lengths", fn() {
    _, _, err := pubkey.key_info(unhex("3080") + P256[2:len(P256)] + unhex("0000"))
    expect(err).to_be_error("pubkey: indefinite DER length")
    _, _, err = pubkey.key_info(unhex("308159") + P256[2:len(P256)])
    expect(err).to_be_error("pubkey: non-minimal DER length")
  })
  it("returns an error for empty input and a wrong tag", fn() {
    _, _, err := pubkey.key_info("")
    expect(err).to_be_error("pubkey: truncated DER")
    _, _, err = pubkey.key_info(unhex("3100"))
    expect(err).to_be_error("pubkey: unexpected DER tag 49")
  })
  it("returns an error for every single-bit flip of a key without crashing", fn() {
    for _, key := range []str{P256, ED25519} {
      i := 0
      while i < len(key) {
        k := flip(key, i)
        pubkey.key_info(k)
        expect(pubkey.verify_signature("ecdsa-p256-sha256", k, MSG, SIG_P256_SHA256)).not_().to_be_nil()
        i++
      }
    }
  })
  it("returns an error for an unsupported key algorithm or curve", fn() {
    # secp256k1 (1.3.132.0.10)
    key := tlv(0x30, tlv(0x30, tlv(0x06, unhex("2a8648ce3d0201")) + tlv(0x06, unhex("2b8104000a"))) + tlv(0x03, unhex("00") + P256[len(P256) - 65:len(P256)]))
    _, _, err := pubkey.key_info(key)
    expect(err).to_be_error("pubkey: unsupported elliptic curve")
    # DSA (1.2.840.10040.4.1)
    key = tlv(0x30, tlv(0x30, tlv(0x06, unhex("2a8648ce380401"))) + tlv(0x03, unhex("00")))
    _, _, err = pubkey.key_info(key)
    expect(err).to_be_error("pubkey: unsupported public key algorithm")
  })
})

describe("pubkey.key_info", fn() {
  it("reports RSA keys with their modulus size", fn() {
    kind, bits, err := pubkey.key_info(RSA2048)
    expect(err).to_be_nil()
    expect(kind).to_equal("rsa")
    expect(bits).to_equal(2048)
    _, bits, _ = pubkey.key_info(RSA3072)
    expect(bits).to_equal(3072)
    _, bits, _ = pubkey.key_info(RSA4096)
    expect(bits).to_equal(4096)
    _, bits, _ = pubkey.key_info(RSA1024)
    expect(bits).to_equal(1024)
    kind, bits, _ = pubkey.key_info(RSA_PSS_KEY)
    expect(kind).to_equal("rsa")
    expect(bits).to_equal(2048)
  })
  it("reports ECDSA and Ed25519 keys", fn() {
    kind, bits, err := pubkey.key_info(P256)
    expect(err).to_be_nil()
    expect(kind).to_equal("ecdsa-p256")
    expect(bits).to_equal(256)
    kind, bits, _ = pubkey.key_info(P384)
    expect(kind).to_equal("ecdsa-p384")
    expect(bits).to_equal(384)
    kind, bits, _ = pubkey.key_info(ED25519)
    expect(kind).to_equal("ed25519")
    expect(bits).to_equal(256)
  })
})

describe("pubkey.ecdh", fn() {
  it("gives both sides the same secret on P-256 and P-384", fn() {
    for _, curve := range []str{"p256", "p384"} {
      a, pa, e1 := pubkey.ecdh_generate(curve)
      b, pb, e2 := pubkey.ecdh_generate(curve)
      expect(e1).to_be_nil()
      expect(e2).to_be_nil()
      s1, _ := pubkey.ecdh(curve, a, pb)
      s2, _ := pubkey.ecdh(curve, b, pa)
      expect(len(s1)).to_equal(len(a))
      expect(s1).to_equal(s2)
    }
  })
  it("refuses a peer point that is not on the curve", fn() {
    a, pa, _ := pubkey.ecdh_generate("p256")
    bad := pa[0:64] + string([]byte{byte(int(pa[64]) ^ 1)})
    _, err := pubkey.ecdh("p256", a, bad)
    expect(err).not_().to_be_nil()
  })
})
