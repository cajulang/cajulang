# std/cipher: authenticated encryption with associated data (AEAD), the record protection of
# TLS 1.3: AES-GCM (AES-128, AES-192 and AES-256; NIST SP 800-38D) and ChaCha20-Poly1305
# (RFC 8439).
#
# Every function takes binary strings. seal gives ciphertext || 16-byte tag; open checks the tag
# in constant time and refuses the message ("cipher: message authentication failed") before
# decrypting anything. A nonce must never be reused with the same key.
#
# For many messages under one key (TLS records), make an Aead once with new_aes_gcm or
# new_chacha20_poly1305: the AES key schedule and the GHASH table are computed there, and each
# seal/open only allocates its result.
#
# Security note: AES here uses lookup tables (T-tables) indexed by secret data, so it is NOT
# constant-time against cache-timing attackers running on the same machine (shared CPU caches).
# That is acceptable for now (there is no AES-NI path yet); ChaCha20-Poly1305 has no secret-
# dependent table lookups or branches, prefer it where that threat matters. GHASH uses 4-bit
# tables of multiples of H (Shoup's method), with the same caveat.

import "std/crypto"

const M32 = 0xFFFFFFFF
const M60 = 0x0FFFFFFFFFFFFFFF
const M26 = 0x3FFFFFF

# the nonce size of both AEADs, in bytes
export const NONCE_SIZE = 12
# the tag size (what seal adds to the plaintext), in bytes
export const TAG_SIZE = 16
# the ChaCha20-Poly1305 key size, in bytes
export const CHACHA20_KEY_SIZE = 32

const KIND_AES_GCM = 1
const KIND_CHACHA = 2

# offsets in an Aead's scratch memory
const TMP_KS = 0        # 64 bytes: keystream of a partial last block
const TMP_OTK = 64      # 32 bytes: the Poly1305 one-time key
const TMP_PAD = 96      # 16 bytes: a zero-padded block
const TMP_Y = 112       # 16 bytes: the GHASH state (two 64-bit words)
const TMP_EK = 128      # 16 bytes: E(K, J0)
const TMP_POLY = 160    # 144 bytes: the Poly1305 state
const TMP_SIZE = 304

# the AES S-box (FIPS 197, figure 7)
let AES_SBOX = []int{
  0x63, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5, 0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76,
  0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0,
  0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15,
  0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75,
  0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84,
  0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf,
  0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8,
  0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2,
  0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73,
  0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb,
  0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79,
  0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
  0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
  0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
  0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
  0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16}

# the GHASH reduction table (Shoup): what the 4 bits shifted out of x^128 fold back into, << 48
let GCM_RED = []int{0x0000, 0x1c20, 0x3840, 0x2460, 0x7080, 0x6ca0, 0x48c0, 0x54e0,
  0xe100, 0xfd20, 0xd940, 0xc560, 0x9180, 0x8da0, 0xa9c0, 0xb5e0}

# The tables, built once on first use, in raw memory: Te0..Te3 (4 x 256 little-endian 32-bit
# words: one column of MixColumns(SubBytes(x)) per row), the S-box bytes, and GHASH's reduction
# table. Words of the AES state are little-endian (byte 0 of a column in the low bits), so blocks
# load and store with no byte swapping.
let tab_mem = ""
let tab_te: int = 0
let tab_sbox: int = 0
let tab_red: int = 0

fn tables() {
  if tab_te != 0 { return }
  m := __newstr(4096 + 256 + 128)
  p := m + 8
  i := 0
  while i < 256 {
    s := AES_SBOX[i]
    s2 := ((s << 1) ^ (((s >> 7) & 1) * 0x11b)) & 255
    w := s2 | (s << 8) | (s << 16) | ((s2 ^ s) << 24)
    __store32(p + 4 * i, w)
    __store32(p + 1024 + 4 * i, ((w << 8) | (w >> 24)) & M32)
    __store32(p + 2048 + 4 * i, ((w << 16) | (w >> 16)) & M32)
    __store32(p + 3072 + 4 * i, ((w << 24) | (w >> 8)) & M32)
    __store8(p + 4096 + i, s)
    i++
  }
  k := 0
  while k < 16 {
    __store64(p + 4352 + 8 * k, GCM_RED[k] << 48)
    k++
  }
  tab_mem = __pstr(m)
  tab_sbox = p + 4096
  tab_red = p + 4352
  tab_te = p
}

# ---------------------------------------------------------------- helpers

fn bswap64(x: int) -> int {
  x = ((x >> 8) & 0x00FF00FF00FF00FF) | ((x & 0x00FF00FF00FF00FF) << 8)
  x = ((x >> 16) & 0x0000FFFF0000FFFF) | ((x & 0x0000FFFF0000FFFF) << 16)
  return ((x >> 32) & M32) | (x << 32)
}

fn zero(p: int, n: int) {
  i := 0
  while i < n {
    __store8(p + i, 0)
    i++
  }
}

fn copy(dst: int, src: int, n: int) {
  i := 0
  while i < n {
    __store8(dst + i, __load8(src + i))
    i++
  }
}

fn auth_error() -> error { return errors.New("cipher: message authentication failed") }
fn nonce_error(n: int) -> error { return errors.New("cipher: the nonce must have 12 bytes, not " + str(n)) }

# ---------------------------------------------------------------- AES (FIPS 197), CTR mode

fn sub_word(sb: int, w: int) -> int {
  return __load8(sb + (w & 255)) | (__load8(sb + ((w >> 8) & 255)) << 8) | (__load8(sb + ((w >> 16) & 255)) << 16) | (__load8(sb + ((w >> 24) & 255)) << 24)
}

# expands key (nk 32-bit words at kp) into 4 * (nk + 7) round-key words at rk
fn aes_expand(kp: int, nk: int, rk: int) {
  sb := tab_sbox
  total := 4 * (nk + 7)
  i := 0
  while i < nk {
    __store32(rk + 4 * i, __load32(kp + 4 * i))
    i++
  }
  rcon := 1
  while i < total {
    t := __load32(rk + 4 * (i - 1))
    if i % nk == 0 {
      t = sub_word(sb, ((t >> 8) | (t << 24)) & M32) ^ rcon
      rcon = ((rcon << 1) ^ (((rcon >> 7) & 1) * 0x11b)) & 255
    } else if nk > 6 && i % nk == 4 {
      t = sub_word(sb, t)
    }
    __store32(rk + 4 * i, __load32(rk + 4 * (i - nk)) ^ t)
    i++
  }
}

# CTR mode: XORs n bytes at inp with the keystream E(K, nonce || ctr), E(K, nonce || ctr + 1)...
# (the 32-bit counter big-endian, as GCM wants) into outp; inp may be outp. np: the 12-byte
# nonce; tmp: 16 bytes of scratch.
fn aes_ctr(rk: int, nr: int, np: int, ctr: int, inp: int, outp: int, n: int, tmp: int) {
  te0 := tab_te
  te1 := te0 + 1024
  te2 := te0 + 2048
  te3 := te0 + 3072
  sb := tab_sbox
  n0 := __load32(np) ^ __load32(rk)
  n1 := __load32(np + 4) ^ __load32(rk + 4)
  n2 := __load32(np + 8) ^ __load32(rk + 8)
  k3 := __load32(rk + 12)
  i := 0
  while i < n {
    c := ctr & M32
    s0 := n0
    s1 := n1
    s2 := n2
    s3 := (((c >> 24) & 255) | ((c >> 8) & 0xff00) | ((c << 8) & 0xff0000) | ((c << 24) & 0xff000000)) ^ k3
    k := rk + 16
    r := 1
    while r < nr {
      t0 := __load32(te0 + ((s0 << 2) & 1020)) ^ __load32(te1 + ((s1 >> 6) & 1020)) ^ __load32(te2 + ((s2 >> 14) & 1020)) ^ __load32(te3 + ((s3 >> 22) & 1020)) ^ __load32(k)
      t1 := __load32(te0 + ((s1 << 2) & 1020)) ^ __load32(te1 + ((s2 >> 6) & 1020)) ^ __load32(te2 + ((s3 >> 14) & 1020)) ^ __load32(te3 + ((s0 >> 22) & 1020)) ^ __load32(k + 4)
      t2 := __load32(te0 + ((s2 << 2) & 1020)) ^ __load32(te1 + ((s3 >> 6) & 1020)) ^ __load32(te2 + ((s0 >> 14) & 1020)) ^ __load32(te3 + ((s1 >> 22) & 1020)) ^ __load32(k + 8)
      t3 := __load32(te0 + ((s3 << 2) & 1020)) ^ __load32(te1 + ((s0 >> 6) & 1020)) ^ __load32(te2 + ((s1 >> 14) & 1020)) ^ __load32(te3 + ((s2 >> 22) & 1020)) ^ __load32(k + 12)
      s0 = t0
      s1 = t1
      s2 = t2
      s3 = t3
      k += 16
      r++
    }
    o0 := (__load8(sb + (s0 & 255)) | (__load8(sb + ((s1 >> 8) & 255)) << 8) | (__load8(sb + ((s2 >> 16) & 255)) << 16) | (__load8(sb + (s3 >> 24)) << 24)) ^ __load32(k)
    o1 := (__load8(sb + (s1 & 255)) | (__load8(sb + ((s2 >> 8) & 255)) << 8) | (__load8(sb + ((s3 >> 16) & 255)) << 16) | (__load8(sb + (s0 >> 24)) << 24)) ^ __load32(k + 4)
    o2 := (__load8(sb + (s2 & 255)) | (__load8(sb + ((s3 >> 8) & 255)) << 8) | (__load8(sb + ((s0 >> 16) & 255)) << 16) | (__load8(sb + (s1 >> 24)) << 24)) ^ __load32(k + 8)
    o3 := (__load8(sb + (s3 & 255)) | (__load8(sb + ((s0 >> 8) & 255)) << 8) | (__load8(sb + ((s1 >> 16) & 255)) << 16) | (__load8(sb + (s2 >> 24)) << 24)) ^ __load32(k + 12)
    if i + 16 <= n {
      __store64(outp + i, __load64(inp + i) ^ (o0 | (o1 << 32)))
      __store64(outp + i + 8, __load64(inp + i + 8) ^ (o2 | (o3 << 32)))
    } else {
      __store32(tmp, o0)
      __store32(tmp + 4, o1)
      __store32(tmp + 8, o2)
      __store32(tmp + 12, o3)
      j := 0
      while i + j < n {
        __store8(outp + i + j, __load8(inp + i + j) ^ __load8(tmp + j))
        j++
      }
    }
    i += 16
    ctr++
  }
}

# ---------------------------------------------------------------- GHASH
#
# Field elements are two 64-bit words read big-endian from the block (lo = bytes 0..7). In GCM's
# bit order multiplying by x is a right shift. The table holds the 16 multiples of H by the
# 4-bit polynomials, indexed bit-reversed (as in Go's crypto/cipher), 16 bytes each.

fn rev4(i: int) -> int {
  i = ((i << 2) & 0xc) | ((i >> 2) & 3)
  return ((i << 1) & 0xa) | ((i >> 1) & 5)
}

# builds the table at ht from H (16 bytes at hp)
fn ghash_init(ht: int, hp: int) {
  hl := bswap64(__load64(hp))
  hh := bswap64(__load64(hp + 8))
  zero(ht, 256)
  __store64(ht + 16 * rev4(1), hl)
  __store64(ht + 16 * rev4(1) + 8, hh)
  i := 2
  while i < 16 {
    src := ht + 16 * rev4(i / 2)
    l := __load64(src)
    h := __load64(src + 8)
    dl := (l >> 1) & 0x7FFFFFFFFFFFFFFF
    dh := ((h >> 1) & 0x7FFFFFFFFFFFFFFF) | (l << 63)
    if (h & 1) == 1 { dl = dl ^ (0xe1 << 56) }
    d := ht + 16 * rev4(i)
    __store64(d, dl)
    __store64(d + 8, dh)
    e := ht + 16 * rev4(i + 1)
    __store64(e, dl ^ hl)
    __store64(e + 8, dh ^ hh)
    i += 2
  }
}

# y = (y ^ block) * H for each 16-byte block of the n bytes at p (n a multiple of 16); y: the
# state, 16 bytes at yp
fn ghash_blocks(ht: int, yp: int, p: int, n: int) {
  red := tab_red
  yl := __load64(yp)
  yh := __load64(yp + 8)
  i := 0
  while i < n {
    yl = yl ^ bswap64(__load64(p + i))
    yh = yh ^ bswap64(__load64(p + i + 8))
    zl := 0
    zh := 0
    w := yh
    j := 0
    while j < 32 {
      if j == 16 { w = yl }
      msw := zh & 15
      zh = ((zh >> 4) & M60) | (zl << 60)
      zl = ((zl >> 4) & M60) ^ __load64(red + 8 * msw)
      e := ht + ((w & 15) << 4)
      zl = zl ^ __load64(e)
      zh = zh ^ __load64(e + 8)
      w = w >> 4
      j++
    }
    yl = zl
    yh = zh
    i += 16
  }
  __store64(yp, yl)
  __store64(yp + 8, yh)
}

# GHASH of n bytes, the last block padded with zeros (pad: 16 bytes of scratch)
fn ghash_padded(ht: int, yp: int, p: int, n: int, pad: int) {
  full := n - (n & 15)
  ghash_blocks(ht, yp, p, full)
  if full < n {
    zero(pad, 16)
    copy(pad, p + full, n - full)
    ghash_blocks(ht, yp, pad, 16)
  }
}

# the GCM tag of n ciphertext bytes at c, written to dst (16 bytes)
fn (a: *Aead) gcm_tag(np: int, aad: str, c: int, n: int, dst: int) {
  t := a.tmp
  yp := t + TMP_Y
  pad := t + TMP_PAD
  __store64(yp, 0)
  __store64(yp + 8, 0)
  ghash_padded(a.htab, yp, __strp(aad) + 8, len(aad), pad)
  ghash_padded(a.htab, yp, c, n, pad)
  __store64(pad, bswap64(len(aad) * 8))
  __store64(pad + 8, bswap64(n * 8))
  ghash_blocks(a.htab, yp, pad, 16)
  ek := t + TMP_EK
  zero(ek, 16)
  aes_ctr(a.rk, a.rounds, np, 1, ek, ek, 16, t + TMP_KS)
  __store64(dst, __load64(ek) ^ bswap64(__load64(yp)))
  __store64(dst + 8, __load64(ek + 8) ^ bswap64(__load64(yp + 8)))
}

# ---------------------------------------------------------------- ChaCha20 (RFC 8439, 2.3-2.4)

# XORs n bytes at inp with the ChaCha20 keystream of the key at kp (32 bytes), the nonce at np
# (12 bytes) and the block counter ctr into outp; inp may be outp. tmp: 64 bytes of scratch.
fn chacha_xor(kp: int, np: int, ctr: int, inp: int, outp: int, n: int, tmp: int) {
  k0 := __load32(kp)
  k1 := __load32(kp + 4)
  k2 := __load32(kp + 8)
  k3 := __load32(kp + 12)
  k4 := __load32(kp + 16)
  k5 := __load32(kp + 20)
  k6 := __load32(kp + 24)
  k7 := __load32(kp + 28)
  c1 := __load32(np)
  c2 := __load32(np + 4)
  c3 := __load32(np + 8)
  i := 0
  while i < n {
    c0 := ctr & M32
    x0 := 0x61707865
    x1 := 0x3320646e
    x2 := 0x79622d32
    x3 := 0x6b206574
    x4 := k0
    x5 := k1
    x6 := k2
    x7 := k3
    x8 := k4
    x9 := k5
    x10 := k6
    x11 := k7
    x12 := c0
    x13 := c1
    x14 := c2
    x15 := c3
    r := 0
    while r < 10 {
      x0 = (x0 + x4) & M32
      x12 = x12 ^ x0
      x12 = ((x12 << 16) | (x12 >> 16)) & M32
      x8 = (x8 + x12) & M32
      x4 = x4 ^ x8
      x4 = ((x4 << 12) | (x4 >> 20)) & M32
      x0 = (x0 + x4) & M32
      x12 = x12 ^ x0
      x12 = ((x12 << 8) | (x12 >> 24)) & M32
      x8 = (x8 + x12) & M32
      x4 = x4 ^ x8
      x4 = ((x4 << 7) | (x4 >> 25)) & M32
      x1 = (x1 + x5) & M32
      x13 = x13 ^ x1
      x13 = ((x13 << 16) | (x13 >> 16)) & M32
      x9 = (x9 + x13) & M32
      x5 = x5 ^ x9
      x5 = ((x5 << 12) | (x5 >> 20)) & M32
      x1 = (x1 + x5) & M32
      x13 = x13 ^ x1
      x13 = ((x13 << 8) | (x13 >> 24)) & M32
      x9 = (x9 + x13) & M32
      x5 = x5 ^ x9
      x5 = ((x5 << 7) | (x5 >> 25)) & M32
      x2 = (x2 + x6) & M32
      x14 = x14 ^ x2
      x14 = ((x14 << 16) | (x14 >> 16)) & M32
      x10 = (x10 + x14) & M32
      x6 = x6 ^ x10
      x6 = ((x6 << 12) | (x6 >> 20)) & M32
      x2 = (x2 + x6) & M32
      x14 = x14 ^ x2
      x14 = ((x14 << 8) | (x14 >> 24)) & M32
      x10 = (x10 + x14) & M32
      x6 = x6 ^ x10
      x6 = ((x6 << 7) | (x6 >> 25)) & M32
      x3 = (x3 + x7) & M32
      x15 = x15 ^ x3
      x15 = ((x15 << 16) | (x15 >> 16)) & M32
      x11 = (x11 + x15) & M32
      x7 = x7 ^ x11
      x7 = ((x7 << 12) | (x7 >> 20)) & M32
      x3 = (x3 + x7) & M32
      x15 = x15 ^ x3
      x15 = ((x15 << 8) | (x15 >> 24)) & M32
      x11 = (x11 + x15) & M32
      x7 = x7 ^ x11
      x7 = ((x7 << 7) | (x7 >> 25)) & M32
      x0 = (x0 + x5) & M32
      x15 = x15 ^ x0
      x15 = ((x15 << 16) | (x15 >> 16)) & M32
      x10 = (x10 + x15) & M32
      x5 = x5 ^ x10
      x5 = ((x5 << 12) | (x5 >> 20)) & M32
      x0 = (x0 + x5) & M32
      x15 = x15 ^ x0
      x15 = ((x15 << 8) | (x15 >> 24)) & M32
      x10 = (x10 + x15) & M32
      x5 = x5 ^ x10
      x5 = ((x5 << 7) | (x5 >> 25)) & M32
      x1 = (x1 + x6) & M32
      x12 = x12 ^ x1
      x12 = ((x12 << 16) | (x12 >> 16)) & M32
      x11 = (x11 + x12) & M32
      x6 = x6 ^ x11
      x6 = ((x6 << 12) | (x6 >> 20)) & M32
      x1 = (x1 + x6) & M32
      x12 = x12 ^ x1
      x12 = ((x12 << 8) | (x12 >> 24)) & M32
      x11 = (x11 + x12) & M32
      x6 = x6 ^ x11
      x6 = ((x6 << 7) | (x6 >> 25)) & M32
      x2 = (x2 + x7) & M32
      x13 = x13 ^ x2
      x13 = ((x13 << 16) | (x13 >> 16)) & M32
      x8 = (x8 + x13) & M32
      x7 = x7 ^ x8
      x7 = ((x7 << 12) | (x7 >> 20)) & M32
      x2 = (x2 + x7) & M32
      x13 = x13 ^ x2
      x13 = ((x13 << 8) | (x13 >> 24)) & M32
      x8 = (x8 + x13) & M32
      x7 = x7 ^ x8
      x7 = ((x7 << 7) | (x7 >> 25)) & M32
      x3 = (x3 + x4) & M32
      x14 = x14 ^ x3
      x14 = ((x14 << 16) | (x14 >> 16)) & M32
      x9 = (x9 + x14) & M32
      x4 = x4 ^ x9
      x4 = ((x4 << 12) | (x4 >> 20)) & M32
      x3 = (x3 + x4) & M32
      x14 = x14 ^ x3
      x14 = ((x14 << 8) | (x14 >> 24)) & M32
      x9 = (x9 + x14) & M32
      x4 = x4 ^ x9
      x4 = ((x4 << 7) | (x4 >> 25)) & M32
      r++
    }
    x0 = (x0 + 0x61707865) & M32
    x1 = (x1 + 0x3320646e) & M32
    x2 = (x2 + 0x79622d32) & M32
    x3 = (x3 + 0x6b206574) & M32
    x4 = (x4 + k0) & M32
    x5 = (x5 + k1) & M32
    x6 = (x6 + k2) & M32
    x7 = (x7 + k3) & M32
    x8 = (x8 + k4) & M32
    x9 = (x9 + k5) & M32
    x10 = (x10 + k6) & M32
    x11 = (x11 + k7) & M32
    x12 = (x12 + c0) & M32
    x13 = (x13 + c1) & M32
    x14 = (x14 + c2) & M32
    x15 = (x15 + c3) & M32
    if i + 64 <= n {
      p := inp + i
      q := outp + i
      __store64(q, __load64(p) ^ (x0 | (x1 << 32)))
      __store64(q + 8, __load64(p + 8) ^ (x2 | (x3 << 32)))
      __store64(q + 16, __load64(p + 16) ^ (x4 | (x5 << 32)))
      __store64(q + 24, __load64(p + 24) ^ (x6 | (x7 << 32)))
      __store64(q + 32, __load64(p + 32) ^ (x8 | (x9 << 32)))
      __store64(q + 40, __load64(p + 40) ^ (x10 | (x11 << 32)))
      __store64(q + 48, __load64(p + 48) ^ (x12 | (x13 << 32)))
      __store64(q + 56, __load64(p + 56) ^ (x14 | (x15 << 32)))
    } else {
      __store64(tmp, x0 | (x1 << 32))
      __store64(tmp + 8, x2 | (x3 << 32))
      __store64(tmp + 16, x4 | (x5 << 32))
      __store64(tmp + 24, x6 | (x7 << 32))
      __store64(tmp + 32, x8 | (x9 << 32))
      __store64(tmp + 40, x10 | (x11 << 32))
      __store64(tmp + 48, x12 | (x13 << 32))
      __store64(tmp + 56, x14 | (x15 << 32))
      j := 0
      while i + j < n {
        __store8(outp + i + j, __load8(inp + i + j) ^ __load8(tmp + j))
        j++
      }
    }
    i += 64
    ctr++
  }
}

# ---------------------------------------------------------------- Poly1305 (RFC 8439, 2.5)
#
# 130-bit arithmetic in five 26-bit limbs (as poly1305-donna-32): products of limbs fit in 64
# bits with room to spare. The state at st (18 words): h0..h4, r0..r4, 5*r1..5*r4, s0..s3.

fn poly_init(st: int, k: int) {
  zero(st, 40)
  r0 := __load32(k) & 0x3ffffff
  r1 := (__load32(k + 3) >> 2) & 0x3ffff03
  r2 := (__load32(k + 6) >> 4) & 0x3ffc0ff
  r3 := (__load32(k + 9) >> 6) & 0x3f03fff
  r4 := (__load32(k + 12) >> 8) & 0x00fffff
  __store64(st + 40, r0)
  __store64(st + 48, r1)
  __store64(st + 56, r2)
  __store64(st + 64, r3)
  __store64(st + 72, r4)
  __store64(st + 80, r1 * 5)
  __store64(st + 88, r2 * 5)
  __store64(st + 96, r3 * 5)
  __store64(st + 104, r4 * 5)
  i := 0
  while i < 4 {
    __store64(st + 112 + 8 * i, __load32(k + 16 + 4 * i))
    i++
  }
}

# absorbs the 16-byte blocks of n bytes at p (n a multiple of 16); hibit: 1 << 24 for full
# blocks, 0 for a final block already padded with 1
fn poly_blocks(st: int, p: int, n: int, hibit: int) {
  h0 := __load64(st)
  h1 := __load64(st + 8)
  h2 := __load64(st + 16)
  h3 := __load64(st + 24)
  h4 := __load64(st + 32)
  r0 := __load64(st + 40)
  r1 := __load64(st + 48)
  r2 := __load64(st + 56)
  r3 := __load64(st + 64)
  r4 := __load64(st + 72)
  s1 := __load64(st + 80)
  s2 := __load64(st + 88)
  s3 := __load64(st + 96)
  s4 := __load64(st + 104)
  i := 0
  while i < n {
    m := p + i
    h0 += __load32(m) & M26
    h1 += (__load32(m + 3) >> 2) & M26
    h2 += (__load32(m + 6) >> 4) & M26
    h3 += (__load32(m + 9) >> 6) & M26
    h4 += (__load32(m + 12) >> 8) | hibit
    d0 := h0 * r0 + h1 * s4 + h2 * s3 + h3 * s2 + h4 * s1
    d1 := h0 * r1 + h1 * r0 + h2 * s4 + h3 * s3 + h4 * s2
    d2 := h0 * r2 + h1 * r1 + h2 * r0 + h3 * s4 + h4 * s3
    d3 := h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0 + h4 * s4
    d4 := h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0
    d1 += d0 >> 26
    h0 = d0 & M26
    d2 += d1 >> 26
    h1 = d1 & M26
    d3 += d2 >> 26
    h2 = d2 & M26
    d4 += d3 >> 26
    h3 = d3 & M26
    c := d4 >> 26
    h4 = d4 & M26
    h0 += c * 5
    c = h0 >> 26
    h0 = h0 & M26
    h1 += c
    i += 16
  }
  __store64(st, h0)
  __store64(st + 8, h1)
  __store64(st + 16, h2)
  __store64(st + 24, h3)
  __store64(st + 32, h4)
}

# the tag (16 bytes at dst): h fully reduced mod 2^130 - 5, plus s, mod 2^128
fn poly_finish(st: int, dst: int) {
  h0 := __load64(st)
  h1 := __load64(st + 8)
  h2 := __load64(st + 16)
  h3 := __load64(st + 24)
  h4 := __load64(st + 32)
  c := h1 >> 26
  h1 = h1 & M26
  h2 += c
  c = h2 >> 26
  h2 = h2 & M26
  h3 += c
  c = h3 >> 26
  h3 = h3 & M26
  h4 += c
  c = h4 >> 26
  h4 = h4 & M26
  h0 += c * 5
  c = h0 >> 26
  h0 = h0 & M26
  h1 += c
  # g = h + 5 - 2^130; keep g if it is not negative (h >= 2^130 - 5), without branching
  g0 := h0 + 5
  c = g0 >> 26
  g0 = g0 & M26
  g1 := h1 + c
  c = g1 >> 26
  g1 = g1 & M26
  g2 := h2 + c
  c = g2 >> 26
  g2 = g2 & M26
  g3 := h3 + c
  c = g3 >> 26
  g3 = g3 & M26
  g4 := h4 + c - (1 << 26)
  mask := (g4 >> 63) ^ -1       # all ones when g4 >= 0
  nm := mask ^ -1
  h0 = (h0 & nm) | (g0 & mask)
  h1 = (h1 & nm) | (g1 & mask)
  h2 = (h2 & nm) | (g2 & mask)
  h3 = (h3 & nm) | (g3 & mask)
  h4 = (h4 & nm) | (g4 & mask)
  # to four 32-bit words, then + s
  w0 := (h0 | (h1 << 26)) & M32
  w1 := ((h1 >> 6) | (h2 << 20)) & M32
  w2 := ((h2 >> 12) | (h3 << 14)) & M32
  w3 := ((h3 >> 18) | (h4 << 8)) & M32
  f := w0 + __load64(st + 112)
  __store32(dst, f & M32)
  f = w1 + __load64(st + 120) + (f >> 32)
  __store32(dst + 4, f & M32)
  f = w2 + __load64(st + 128) + (f >> 32)
  __store32(dst + 8, f & M32)
  f = w3 + __load64(st + 136) + (f >> 32)
  __store32(dst + 12, f & M32)
}

# the ChaCha20-Poly1305 tag of n ciphertext bytes at c, written to dst (16 bytes)
fn (a: *Aead) chacha_tag(np: int, aad: str, c: int, n: int, dst: int) {
  t := a.tmp
  otk := t + TMP_OTK
  zero(otk, 32)
  chacha_xor(a.rk, np, 0, otk, otk, 32, t + TMP_KS)
  st := t + TMP_POLY
  poly_init(st, otk)
  pad := t + TMP_PAD
  poly_padded(st, __strp(aad) + 8, len(aad), pad)
  poly_padded(st, c, n, pad)
  __store64(pad, len(aad))
  __store64(pad + 8, n)
  poly_blocks(st, pad, 16, 1 << 24)
  poly_finish(st, dst)
}

# absorbs n bytes, the last block padded with zeros (RFC 8439's pad16)
fn poly_padded(st: int, p: int, n: int, pad: int) {
  full := n - (n & 15)
  poly_blocks(st, p, full, 1 << 24)
  if full < n {
    zero(pad, 16)
    copy(pad, p + full, n - full)
    poly_blocks(st, pad, 16, 1 << 24)
  }
}

# ---------------------------------------------------------------- the AEAD

# Aead: an AES-GCM or ChaCha20-Poly1305 key, ready to seal and open many messages
export struct Aead {
  kind: int
  rounds: int       # AES: 10, 12 or 14
  mem: str          # keeps the raw memory below alive
  rk: int           # AES round keys (32-bit words) or the ChaCha20 key (32 bytes)
  htab: int         # GHASH: the 16 multiples of H
  tmp: int          # scratch (TMP_*)
}

fn new_aead(kind: int) -> *Aead {
  m := __newstr(240 + 256 + TMP_SIZE)
  p := m + 8
  return &Aead{kind: kind, rounds: 0, mem: __pstr(m), rk: p, htab: p + 240, tmp: p + 496}
}

# an AES-GCM AEAD; key: 16 bytes (AES-128), 24 (AES-192) or 32 (AES-256)
export fn new_aes_gcm(key: str) -> (*Aead, error) {
  if len(key) != 16 && len(key) != 24 && len(key) != 32 { return nil, errors.New("cipher: an AES key has 16, 24 or 32 bytes, not " + str(len(key))) }
  tables()
  a := new_aead(KIND_AES_GCM)
  nk := len(key) / 4
  a.rounds = nk + 6
  aes_expand(__strp(key) + 8, nk, a.rk)
  # H = E(K, 0^128): the CTR keystream of a zero nonce at counter 0
  hp := a.tmp + TMP_EK
  zero(hp, 16)
  aes_ctr(a.rk, a.rounds, hp, 0, hp, hp, 16, a.tmp + TMP_KS)
  ghash_init(a.htab, hp)
  return a, nil
}

# a ChaCha20-Poly1305 AEAD (RFC 8439); key: 32 bytes
export fn new_chacha20_poly1305(key: str) -> (*Aead, error) {
  if len(key) != CHACHA20_KEY_SIZE { return nil, errors.New("cipher: a ChaCha20-Poly1305 key has 32 bytes, not " + str(len(key))) }
  a := new_aead(KIND_CHACHA)
  copy(a.rk, __strp(key) + 8, 32)
  return a, nil
}

# the bytes seal adds to the plaintext (the tag): 16
export fn (a: *Aead) overhead() -> int { return TAG_SIZE }

# encrypts and authenticates plaintext, and authenticates aad (sent in clear); gives ciphertext
# || tag. nonce: 12 bytes, never reused with this key (panics on another size).
export fn (a: *Aead) seal(nonce: str, plaintext: str, aad: str) -> str {
  if len(nonce) != NONCE_SIZE { panic(nonce_error(len(nonce)).Error()) }
  n := len(plaintext)
  out := __newstr(n + TAG_SIZE)
  o := out + 8
  np := __strp(nonce) + 8
  pp := __strp(plaintext) + 8
  if a.kind == KIND_AES_GCM {
    aes_ctr(a.rk, a.rounds, np, 2, pp, o, n, a.tmp + TMP_KS)
    a.gcm_tag(np, aad, o, n, o + n)
  } else {
    chacha_xor(a.rk, np, 1, pp, o, n, a.tmp + TMP_KS)
    a.chacha_tag(np, aad, o, n, o + n)
  }
  return __pstr(out)
}

# checks and decrypts what seal gave (with the same nonce and aad); an error, and no plaintext,
# when anything was changed
export fn (a: *Aead) open(nonce: str, sealed: str, aad: str) -> (str, error) {
  if len(nonce) != NONCE_SIZE { return "", nonce_error(len(nonce)) }
  if len(sealed) < TAG_SIZE { return "", auth_error() }
  n := len(sealed) - TAG_SIZE
  np := __strp(nonce) + 8
  sp := __strp(sealed) + 8
  tag := __newstr(TAG_SIZE)
  if a.kind == KIND_AES_GCM { a.gcm_tag(np, aad, sp, n, tag + 8) } else { a.chacha_tag(np, aad, sp, n, tag + 8) }
  if !crypto.constant_time_eq(__pstr(tag), sealed[n:]) { return "", auth_error() }
  out := __newstr(n)
  if a.kind == KIND_AES_GCM { aes_ctr(a.rk, a.rounds, np, 2, sp, out + 8, n, a.tmp + TMP_KS) } else { chacha_xor(a.rk, np, 1, sp, out + 8, n, a.tmp + TMP_KS) }
  return __pstr(out), nil
}

# ---------------------------------------------------------------- one-shot functions

# AES-GCM: ciphertext || 16-byte tag of plaintext, authenticating aad too. key: 16 or 32 bytes
# (24 also works); nonce: 12 bytes.
export fn aes_gcm_seal(key: str, nonce: str, plaintext: str, aad: str) -> (str, error) {
  a, err := new_aes_gcm(key)
  if err != nil { return "", err }
  if len(nonce) != NONCE_SIZE { return "", nonce_error(len(nonce)) }
  return a.seal(nonce, plaintext, aad), nil
}

# AES-GCM: the plaintext of sealed (ciphertext || tag), or "cipher: message authentication
# failed" if the tag does not match (the key, nonce, ciphertext or aad differ)
export fn aes_gcm_open(key: str, nonce: str, sealed: str, aad: str) -> (str, error) {
  a, err := new_aes_gcm(key)
  if err != nil { return "", err }
  return a.open(nonce, sealed, aad)
}

# ChaCha20-Poly1305 (RFC 8439): ciphertext || 16-byte tag. key: 32 bytes; nonce: 12 bytes.
export fn chacha20_poly1305_seal(key: str, nonce: str, plaintext: str, aad: str) -> (str, error) {
  a, err := new_chacha20_poly1305(key)
  if err != nil { return "", err }
  if len(nonce) != NONCE_SIZE { return "", nonce_error(len(nonce)) }
  return a.seal(nonce, plaintext, aad), nil
}

# ChaCha20-Poly1305: the plaintext of sealed, or "cipher: message authentication failed"
export fn chacha20_poly1305_open(key: str, nonce: str, sealed: str, aad: str) -> (str, error) {
  a, err := new_chacha20_poly1305(key)
  if err != nil { return "", err }
  return a.open(nonce, sealed, aad)
}

# ---------------------------------------------------------------- the raw primitives

# ChaCha20 (RFC 8439, 2.4): data XOR the keystream of key (32 bytes) and nonce (12 bytes),
# starting at block counter. Encrypts and decrypts; no authentication: prefer the AEAD.
export fn chacha20(key: str, nonce: str, counter: int, data: str) -> (str, error) {
  if len(key) != CHACHA20_KEY_SIZE { return "", errors.New("cipher: a ChaCha20 key has 32 bytes, not " + str(len(key))) }
  if len(nonce) != NONCE_SIZE { return "", nonce_error(len(nonce)) }
  out := __newstr(len(data))
  tmp := __newstr(64)
  chacha_xor(__strp(key) + 8, __strp(nonce) + 8, counter, __strp(data) + 8, out + 8, len(data), tmp + 8)
  return __pstr(out), nil
}

# Poly1305 (RFC 8439, 2.5): the 16-byte tag of msg under a 32-byte one-time key (never reuse it)
export fn poly1305(key: str, msg: str) -> (str, error) {
  if len(key) != 32 { return "", errors.New("cipher: a Poly1305 key has 32 bytes, not " + str(len(key))) }
  m := __newstr(144 + 16 + 16)
  st := m + 8
  pad := st + 144
  poly_init(st, __strp(key) + 8)
  n := len(msg)
  p := __strp(msg) + 8
  full := n - (n & 15)
  poly_blocks(st, p, full, 1 << 24)
  if full < n {
    zero(pad, 16)
    copy(pad, p + full, n - full)
    __store8(pad + n - full, 1)
    poly_blocks(st, pad, 16, 0)
  }
  poly_finish(st, pad + 16)
  out := __newstr(16)
  copy(out + 8, pad + 16, 16)
  return __pstr(out), nil
}
