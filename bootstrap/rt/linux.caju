# Native runtime: the Linux part (direct system calls)
let rt_argp: int = 0

fn rt_os_init() {
  p := __argp()
  argc := __load64(p)
  e := p + 8 * (argc + 2)
  while __load64(e) != 0 {
    if rt_cstr_prefix(__load64(e), "CAJU_SKIP_SLEEP=") { rt_skip_sleep = true }
    e += 8
  }
}
fn rt_os_write(p: int, n: int) {
  while n > 0 {
    w := __syscall(1, 1, p, n, 0, 0, 0)
    if w <= 0 { return }
    p += w
    n -= w
  }
}
fn rt_os_mem(n: int) -> int { return __syscall(9, 0, n, 3, 34, -1, 0) }
# reserves addresses without using memory (MAP_NORESERVE); a page only exists once it is touched
fn rt_os_reserve(n: int) -> int { return __syscall(9, 0, n, 3, 16418, -1, 0) }
fn rt_os_commit(p: int, n: int) { }
fn rt_os_exit(c: int) { __syscall(231, c, 0, 0, 0, 0, 0) }
fn rt_os_sleep(s: num) {
  ts := rt_tmp + 64
  sec := int(s)
  __store64(ts, sec)
  __store64(ts + 8, int((s - num(sec)) * 1000000000.0))
  __syscall(35, ts, 0, 0, 0, 0, 0)
}
# the standard library's view of the system (RT_INTRINSICS: __nanotime, __random...), as in rt/linux.caju
fn rt_os_clock(id: int) -> int {
  ts := rt_tmp + 64
  __syscall(228, id, ts, 0, 0, 0, 0)
  return __load64(ts) * 1000000000 + __load64(ts + 8)
}
fn rt_os_nanotime() -> int { return rt_os_clock(1) }
fn rt_os_unix_nano() -> int { return rt_os_clock(0) }
fn rt_os_random(p: int, n: int) -> int {
  got := 0
  while got < n {
    r := __syscall(318, p + got, n - got, 0, 0, 0, 0)
    if r == -4 { continue }
    if r < 0 { return r }
    got += r
  }
  return n
}
fn rt_os_write_fd(fd: int, p: int, n: int) -> int { return __syscall(1, fd, p, n, 0, 0, 0) }
fn rt_os_read_fd(fd: int, p: int, n: int) -> int { return __syscall(0, fd, p, n, 0, 0, 0) }
fn rt_os_isatty(fd: int) -> bool { return __syscall(16, fd, 21505, rt_tmp + 64, 0, 0, 0) == 0 }
