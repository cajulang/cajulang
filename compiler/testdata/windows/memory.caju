# raw memory on Windows (alloc, peek, poke, readstr, readwstr), run by windows_test.caju
p := alloc(16)
poke32(p, 123456)
poke16(p + 4, 65535)
poke8(p + 6, 300)
print(peek32(p), peek16(p + 4), peek8(p + 6), peek64(p))
poke16(p, 72)
poke16(p + 2, 105)
poke16(p + 4, 225)
poke16(p + 6, 0)
print(readwstr(p), readstr(p))
free(p)
free(0)
print(peek32(0))
