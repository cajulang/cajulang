# pkg: the package manager (`caju pkg ...`).
#
# A package is a GitHub repository with a caju.toml at its root; its name is the repository path
# ("github.com/user/repo"), which is also what programs import. A release is a git tag "vX.Y.Z"
# whose caju.toml says version = "X.Y.Z". A project lists the packages it needs in caju.toml
# ([dependencies], each with the minimum version it needs); `caju pkg install` follows the
# dependencies of the dependencies (recursively), picks one version of each package (minimal
# version selection: the highest of the minimums asked for, within one major version), downloads
# them with git into the cache ($CAJU_HOME/pkg, default ~/.caju/pkg) and writes caju.lock with the
# exact version, the git commit and a SHA-256 hash of the files of every package. Builds and
# `caju pkg verify` check the cached files against those hashes; a download whose commit or hash
# differs from caju.lock is refused. See docs/packages.md.

import "std/os"
import "std/fs"
import "std/path"
import "std/strings"
import "std/toml"
import "std/crypto"
import "std/cli"
import "project"

export const VERSION = "0.5.0"     # the version of the compiler (caju version)
const LOCK_VERSION = 1

# ---------------------------------------------------------------- versions (semver)

export struct Version {
  major: int
  minor: int
  patch: int
  pre: str       # "beta.1" in 1.0.0-beta.1, or ""
}

# parses "1.2.3", "v1.2.3" or "1.2.3-beta.1"
export fn parse_version(s: str) -> (*Version, error) {
  t := strings.trim_prefix(s, "v")
  v := &Version{}
  dash := strings.index(t, "-")
  if dash >= 0 {
    v.pre = t[dash + 1:]
    t = t[0:dash]
    if v.pre == "" { return nil, errors.New("invalid version \"" + s + "\"") }
  }
  parts := strings.split(t, ".")
  if len(parts) != 3 { return nil, errors.New("invalid version \"" + s + "\" (expected MAJOR.MINOR.PATCH, like 1.2.0)") }
  nums := []int{}
  for _, p := range parts {
    if p == "" || (len(p) > 1 && p[0] == 48) { return nil, errors.New("invalid version \"" + s + "\"") }
    n := 0
    for i := 0; i < len(p); i++ {
      c := int(p[i])
      if c < 48 || c > 57 { return nil, errors.New("invalid version \"" + s + "\"") }
      n = n * 10 + c - 48
    }
    nums = append(nums, n)
  }
  v.major = nums[0]
  v.minor = nums[1]
  v.patch = nums[2]
  return v, nil
}

export fn (v: *Version) string() -> str {
  s := str(v.major) + "." + str(v.minor) + "." + str(v.patch)
  if v.pre != "" { s = s + "-" + v.pre }
  return s
}

# <0, 0, >0 like a - b; a pre-release comes before its release (1.0.0-beta < 1.0.0)
export fn compare_versions(a: *Version, b: *Version) -> int {
  if a.major != b.major { return a.major - b.major }
  if a.minor != b.minor { return a.minor - b.minor }
  if a.patch != b.patch { return a.patch - b.patch }
  if a.pre == b.pre { return 0 }
  if a.pre == "" { return 1 }
  if b.pre == "" { return -1 }
  if a.pre < b.pre { return -1 }
  return 1
}

fn cmp_text(a: str, b: str) -> int {
  va, _ := parse_version(a)
  vb, _ := parse_version(b)
  return compare_versions(va, vb)
}

# ---------------------------------------------------------------- compiler requirements
#
# The caju field of caju.toml says which versions of the compiler a package works with:
#
#   caju = "0.6.0"             0.6.0 or newer (a bare version is a minimum)
#   caju = ">=0.6.0"           the same
#   caju = ">=0.5.0, <0.7.0"   every clause must hold (separated by commas)
#   caju = "^0.6.0"            compatible: >=0.6.0, <0.7.0 (for 1.2.3: >=1.2.3, <2.0.0)
#   caju = "~0.6.1"            the same minor: >=0.6.1, <0.7.0
#   caju = "=0.6.0"            exactly
#
# Operators: >=, >, <=, <, =, ^, ~. A version may leave out the patch (">=0.6" is ">=0.6.0").

export struct Clause {
  op: str           # ">=", ">", "<=", "<", "="
  v: *Version
}

# the clauses of a requirement, with ^ and ~ turned into a pair of >= and <
export fn parse_requirement(s: str) -> ([]*Clause, error) {
  out := []*Clause{}
  if strings.trim_space(s) == "" { return nil, errors.New("empty requirement") }
  for _, part := range strings.split(s, ",") {
    t := strings.trim_space(part)
    op := ""
    for _, o := range []str{">=", "<=", ">", "<", "=", "^", "~"} {
      if strings.has_prefix(t, o) {
        op = o
        break
      }
    }
    t = strings.trim_space(t[len(op):])
    if strings.count(t, ".") == 1 && strings.index(t, "-") < 0 { t = t + ".0" }
    v, err := parse_version(t)
    if err != nil { return nil, errors.New("invalid requirement \"" + s + "\" (expected something like \">=0.6.0\" or \">=0.5.0, <0.7.0\")") }
    if op == "" { op = ">=" }
    if op == "^" || op == "~" {
      up := &Version{major: v.major + 1}
      if op == "~" || v.major == 0 { up = &Version{major: v.major, minor: v.minor + 1} }
      if op == "^" && v.major == 0 && v.minor == 0 { up = &Version{major: 0, minor: 0, patch: v.patch + 1} }
      out = append(out, &Clause{op: ">=", v: v})
      out = append(out, &Clause{op: "<", v: up})
    } else {
      out = append(out, &Clause{op: op, v: v})
    }
  }
  return out, nil
}

# whether version meets every clause
export fn satisfies(version: str, clauses: []*Clause) -> bool {
  v, err := parse_version(version)
  if err != nil { return false }
  for _, c := range clauses {
    d := compare_versions(v, c.v)
    ok := true
    switch c.op {
    case ">=": ok = d >= 0
    case ">": ok = d > 0
    case "<=": ok = d <= 0
    case "<": ok = d < 0
    case "=": ok = d == 0
    }
    if !ok { return false }
  }
  return true
}

# nil if this compiler (VERSION) meets the requirement of who (a package or the project)
export fn check_compiler(who: str, requirement: str) -> error { return check_compiler_version(who, requirement, VERSION) }

export fn check_compiler_version(who: str, requirement: str, version: str) -> error {
  if requirement == "" { return nil }
  clauses, err := parse_requirement(requirement)
  if err != nil { return errors.New(who + ": " + err.Error()) }
  if satisfies(version, clauses) { return nil }
  return errors.New(who + " needs caju " + requirement + ", but this is caju " + version + " (install another version: curl -fsSL https://raw.githubusercontent.com/cajulang/cajulang/main/install.sh | sh)")
}

# ---------------------------------------------------------------- names

# a package name is "github.com/<owner>/<repo>" with letters, digits, ".", "-", "_"
export fn check_name(name: str) -> error {
  parts := strings.split(name, "/")
  if len(parts) != 3 || parts[0] != "github.com" {
    return errors.New("invalid package name \"" + name + "\" (expected github.com/owner/repository)")
  }
  for _, p := range parts[1:] {
    if p == "" || p == "." || p == ".." { return errors.New("invalid package name \"" + name + "\"") }
    for i := 0; i < len(p); i++ {
      c := int(p[i])
      ok := (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || (c >= 48 && c <= 57) || c == 46 || c == 45 || c == 95
      if !ok { return errors.New("invalid package name \"" + name + "\" (character \"" + p[i:i + 1] + "\")") }
    }
  }
  return nil
}

# ---------------------------------------------------------------- caju.toml

export struct Dep {
  name: str
  version: str     # the minimum version
}

export struct Manifest {
  dir: str
  name: str
  version: str
  description: str
  license: str
  authors: []str
  entry: str       # the file imported by `import "<name>"` (default: <repo>.caju)
  caju: str        # the versions of the compiler it works with (">=0.6.0"...), or ""
  deps: []*Dep     # in the order of caju.toml
}

fn toml_str(t: *toml.Value, key: str, file: str) -> (str, error) {
  v := t.get(key)
  if v == nil { return "", nil }
  if v.kind != "string" { return "", errors.New(file + ": " + key + " must be a string") }
  return v.s, nil
}

# reads <dir>/caju.toml
export fn read_manifest(dir: str) -> (*Manifest, error) {
  file := path.join(dir, "caju.toml")
  src, err := os.read_file(file)
  if err != nil { return nil, errors.New("cannot read " + file + ": " + err.Error()) }
  doc, err2 := toml.parse(src)
  if err2 != nil { return nil, errors.New(file + ": " + err2.Error()) }
  m := &Manifest{dir: dir, authors: []str{}, deps: []*Dep{}}
  pkg := doc.get("package")
  if pkg == nil || pkg.kind != "table" { return nil, errors.New(file + ": missing [package] table") }
  err = nil
  m.name, err = toml_str(pkg, "name", file)
  if err != nil { return nil, err }
  m.version, err = toml_str(pkg, "version", file)
  if err != nil { return nil, err }
  m.description, err = toml_str(pkg, "description", file)
  if err != nil { return nil, err }
  m.license, err = toml_str(pkg, "license", file)
  if err != nil { return nil, err }
  m.entry, err = toml_str(pkg, "entry", file)
  if err != nil { return nil, err }
  m.caju, err = toml_str(pkg, "caju", file)
  if err != nil { return nil, err }
  if m.name == "" { return nil, errors.New(file + ": [package] needs a name") }
  err = check_name(m.name)
  if err != nil { return nil, errors.New(file + ": " + err.Error()) }
  if m.version == "" { m.version = "0.0.0" }
  _, err = parse_version(m.version)
  if err != nil { return nil, errors.New(file + ": " + err.Error()) }
  if m.entry == "" { m.entry = path.base(m.name) + ".caju" }
  if m.caju != "" {
    _, err = parse_requirement(m.caju)
    if err != nil { return nil, errors.New(file + ": caju: " + err.Error()) }
  }
  au := pkg.get("authors")
  if au != nil {
    if au.kind != "array" { return nil, errors.New(file + ": authors must be a list of strings") }
    for _, a := range au.items {
      if a.kind != "string" { return nil, errors.New(file + ": authors must be a list of strings") }
      m.authors = append(m.authors, a.s)
    }
  }
  deps := doc.get("dependencies")
  if deps != nil {
    if deps.kind != "table" { return nil, errors.New(file + ": [dependencies] must be a table") }
    for _, k := range deps.keys {
      v := deps.fields[k]
      if v.kind != "string" { return nil, errors.New(file + ": the version of " + k + " must be a string, like \"1.2.0\"") }
      err = check_name(k)
      if err != nil { return nil, errors.New(file + ": " + err.Error()) }
      _, err = parse_version(v.s)
      if err != nil { return nil, errors.New(file + ": " + k + ": " + err.Error()) }
      if k == m.name { return nil, errors.New(file + ": a package cannot depend on itself") }
      m.deps = append(m.deps, &Dep{name: k, version: strings.trim_prefix(v.s, "v")})
    }
  }
  return m, nil
}

# caju.toml with [dependencies] "name" set to version (added, or changed in place); the rest of
# the file (comments, order) is kept
export fn set_dependency(src: str, name: str, version: str) -> str {
  line := toml.key_text(name) + " = \"" + version + "\""
  lines := strings.split(src, "\n")
  start, end := dep_section(lines)
  if start < 0 {
    s := strings.trim_suffix(src, "\n")
    return s + "\n\n[dependencies]\n" + line + "\n"
  }
  for i := start + 1; i < end; i++ {
    if dep_key(lines[i]) == name {
      lines[i] = line
      return strings.join(lines, "\n")
    }
  }
  # after the last non-empty line of the section
  at := end
  while at > start + 1 && strings.trim_space(lines[at - 1]) == "" { at-- }
  out := []str{}
  for i := 0; i < at; i++ { out = append(out, lines[i]) }
  out = append(out, line)
  for i := at; i < len(lines); i++ { out = append(out, lines[i]) }
  return strings.join(out, "\n")
}

# caju.toml without the dependency name; "" in found if it was not there
export fn remove_dependency(src: str, name: str) -> (out: str, found: bool) {
  lines := strings.split(src, "\n")
  start, end := dep_section(lines)
  if start < 0 { return src, false }
  kept := []str{}
  for i, l := range lines {
    if i > start && i < end && dep_key(l) == name {
      found = true
      continue
    }
    kept = append(kept, l)
  }
  return strings.join(kept, "\n"), found
}

# the line of the [dependencies] header and the line where the section ends
fn dep_section(lines: []str) -> (int, int) {
  start := -1
  for i, l := range lines {
    t := strings.trim_space(l)
    if start < 0 {
      if t == "[dependencies]" { start = i }
      continue
    }
    if strings.has_prefix(t, "[") { return start, i }
  }
  return start, len(lines)
}

# the key of a `key = value` line ("" if the line is not one)
fn dep_key(l: str) -> str {
  t := strings.trim_space(l)
  eq := strings.index(t, "=")
  if eq <= 0 { return "" }
  k := strings.trim_space(t[0:eq])
  if len(k) >= 2 && (k[0] == 34 || k[0] == 39) { k = k[1:len(k) - 1] }
  return k
}

# ---------------------------------------------------------------- caju.lock

export struct Locked {
  name: str
  version: str
  source: str
  commit: str
  hash: str
  deps: []str      # "name@minimum" as its caju.toml says
}

export struct Lock {
  requires: []str  # the project's dependencies ("name@version") when the lock was written
  pkgs: []*Locked  # sorted by name
}

export fn read_lock(file: str) -> (*Lock, error) {
  src, err := os.read_file(file)
  if err != nil { return nil, err }
  doc, err2 := toml.parse(src)
  if err2 != nil { return nil, errors.New(file + ": " + err2.Error()) }
  lk := &Lock{requires: []str{}, pkgs: []*Locked{}}
  v := doc.get("version")
  if v == nil || v.kind != "int" || v.i != LOCK_VERSION { return nil, errors.New(file + ": unknown lock version (expected version = 1)") }
  req := doc.get("requires")
  if req != nil { for _, r := range req.items { lk.requires = append(lk.requires, r.s) } }
  ps := doc.get("package")
  if ps != nil {
    for _, p := range ps.items {
      l := &Locked{deps: []str{}}
      l.name, _ = toml_str(p, "name", file)
      l.version, _ = toml_str(p, "version", file)
      l.source, _ = toml_str(p, "source", file)
      l.commit, _ = toml_str(p, "commit", file)
      l.hash, _ = toml_str(p, "hash", file)
      ds := p.get("dependencies")
      if ds != nil { for _, d := range ds.items { l.deps = append(l.deps, d.s) } }
      if l.name == "" || l.version == "" || l.hash == "" { return nil, errors.New(file + ": a [[package]] needs name, version and hash") }
      lk.pkgs = append(lk.pkgs, l)
    }
  }
  return lk, nil
}

fn str_array(xs: []str) -> *toml.Value {
  a := toml.new_array()
  for _, x := range xs { a.items = append(a.items, toml.new_string(x)) }
  return a
}

export fn encode_lock(lk: *Lock) -> str {
  doc := toml.new_table()
  doc.set("version", toml.new_int(LOCK_VERSION))
  doc.set("requires", str_array(lk.requires))
  arr := toml.new_array()
  for _, l := range lk.pkgs {
    t := toml.new_table()
    t.set("name", toml.new_string(l.name))
    t.set("version", toml.new_string(l.version))
    t.set("source", toml.new_string(l.source))
    t.set("commit", toml.new_string(l.commit))
    t.set("hash", toml.new_string(l.hash))
    t.set("dependencies", str_array(l.deps))
    arr.items = append(arr.items, t)
  }
  if len(lk.pkgs) > 0 { doc.set("package", arr) }
  return "# Written by `caju pkg`; do not edit. It pins the exact version, commit and hash of every\n# package the project uses, directly or not.\n" + toml.encode(doc)
}

fn requires_of(m: *Manifest) -> []str {
  out := []str{}
  for _, d := range m.deps { out = append(out, d.name + "@" + d.version) }
  return out
}

fn same_list(a: []str, b: []str) -> bool {
  if len(a) != len(b) { return false }
  for i := range a { if a[i] != b[i] { return false } }
  return true
}

# ---------------------------------------------------------------- the cache and downloads

# $CAJU_HOME, or ~/.caju
export fn home() -> str {
  h := os.getenv("CAJU_HOME")
  if h != "" { return h }
  return path.join(os.getenv("HOME"), ".caju")
}

export fn cache_dir(name: str, version: str) -> str { return path.join_all([]str{home(), "pkg", name + "@" + version}) }

# where git downloads a package from: https://github.com/owner/repo, or $CAJU_PKG_SOURCE/<name>
# (a mirror or local copies, used by the tests)
export fn source_url(name: str) -> str {
  s := os.getenv("CAJU_PKG_SOURCE")
  if s != "" { return path.join(s, name) }
  return "https://" + name
}

# the hash of a package directory: SHA-256 of the list "<sha256 of file>  <path>\n" of every file
# (sorted by path, .git left out; a symbolic link counts as the text "symlink <target>").
# Written as "sha256:<hex>". It depends only on the files, not on git.
export fn hash_dir(dir: str) -> (str, error) {
  files, err := fs.walk_files(dir)
  if err != nil { return "", err }
  list := strings.Builder{}
  for _, f := range files {
    if f == ".git" || strings.has_prefix(f, ".git/") { continue }
    p := path.join(dir, f)
    fi, err2 := fs.lstat(p)
    if err2 != nil { return "", err2 }
    data := ""
    if fi.is_symlink {
      t, err3 := fs.readlink(p)
      if err3 != nil { return "", err3 }
      data = "symlink " + t
    } else {
      d, err3 := os.read_file(p)
      if err3 != nil { return "", err3 }
      data = d
    }
    list.write(crypto.sha256_hex(data))
    list.write("  ")
    list.write(f)
    list.write("\n")
  }
  return "sha256:" + crypto.sha256_hex(list.string()), nil
}

fn git(args: []str) -> (str, error) {
  argv := []str{"git"}
  for _, a := range args { argv = append(argv, a) }
  p, err := os.run(argv, nil, true)
  if err != nil { return "", errors.New("git is needed to download packages: " + err.Error()) }
  if p.code != 0 { return "", errors.New(strings.trim_space(p.output)) }
  return strings.trim_space(p.output), nil
}

# the release versions (tags vX.Y.Z) of a package, from the newest
export fn remote_versions(name: str) -> ([]str, error) {
  out, err := git([]str{"ls-remote", "--tags", "--refs", source_url(name)})
  if err != nil { return nil, errors.New("cannot list the versions of " + name + ": " + err.Error()) }
  vs := []str{}
  for _, line := range strings.split(out, "\n") {
    i := strings.index(line, "refs/tags/v")
    if i < 0 { continue }
    t := line[i + 10:]
    v, err2 := parse_version(t)
    if err2 == nil && v.string() == t[1:] { vs = append(vs, v.string()) }
  }
  # sort, newest first (insertion sort: tag lists are short)
  for i := 1; i < len(vs); i++ {
    j := i
    while j > 0 && cmp_text(vs[j - 1], vs[j]) < 0 {
      t := vs[j]
      vs[j] = vs[j - 1]
      vs[j - 1] = t
      j--
    }
  }
  return vs, nil
}

# the newest release that is not a pre-release (or the newest of all if there is none)
export fn latest_version(name: str) -> (str, error) {
  vs, err := remote_versions(name)
  if err != nil { return "", err }
  if len(vs) == 0 { return "", errors.New(name + " has no releases (git tags like v1.0.0)") }
  for _, v := range vs { if strings.index(v, "-") < 0 { return v, nil } }
  return vs[0], nil
}

export struct Fetched {
  dir: str
  commit: str
  hash: str
}

# ---- the shared cache
# Every project on the machine shares $CAJU_HOME/pkg: name@version/ holds the files of a release
# (without .git) and name@version.info what was recorded when it was downloaded:
#   commit <git commit>
#   hash sha256:<hash of the files>
# A copy is reused, by any project, only if its files still have the recorded hash; a copy that
# was changed is downloaded again (by install, add, update) or refused (by builds).

export struct CacheEntry {
  name: str
  version: str
  dir: str
  commit: str
  hash: str       # the recorded hash ("" in a copy from before hashes were recorded)
}

# what fetch did since the last reset_log: "reused x@1.0.0 from the cache", "downloaded x@1.0.0"...
let fetch_log: []str = []str{}
export fn reset_log() { fetch_log = []str{} }
export fn log() -> []str { return fetch_log }

fn info_file(dir: str) -> str { return dir + ".info" }

fn read_info(dir: str) -> (commit: str, hash: str, ok: bool) {
  src, err := os.read_file(info_file(dir))
  if err != nil || !fs.is_dir(dir) { return "", "", false }
  for _, line := range strings.split(strings.trim_space(src), "\n") {
    line = strings.trim_space(line)
    if strings.has_prefix(line, "commit ") { commit = strings.trim_space(line[7:]) } else if strings.has_prefix(line, "hash ") { hash = strings.trim_space(line[5:]) } else if commit == "" && line != "" {
      commit = line         # the old format: only the commit
    }
  }
  return commit, hash, true
}

fn write_info(dir: str, commit: str, hash: str) -> error {
  tmp := info_file(dir) + ".tmp"
  err := os.write_file(tmp, "commit " + commit + "\nhash " + hash + "\n", 0o644)
  if err != nil { return err }
  return fs.rename(tmp, info_file(dir))
}

# checks a cached copy: its hash now, and an error if it differs from the one recorded
export fn check_cached(name: str, version: str) -> (*CacheEntry, str, error) {
  dir := cache_dir(name, version)
  commit, recorded, ok := read_info(dir)
  if !ok { return nil, "", errors.New(name + "@" + version + " is not in the cache") }
  h, err := hash_dir(dir)
  if err != nil { return nil, "", err }
  e := &CacheEntry{name: name, version: version, dir: dir, commit: commit, hash: recorded}
  if recorded != "" && h != recorded {
    return e, h, errors.New("the cached copy of " + name + "@" + version + " was changed\n  recorded: " + recorded + "\n  files:    " + h)
  }
  return e, h, nil
}

# the cached copy of name@version, downloading it if needed. want_commit / want_hash ("" = not
# known yet) come from caju.lock: a copy that does not match them is an error.
export fn fetch(name: str, version: str, want_commit: str, want_hash: str) -> (*Fetched, error) {
  dst := cache_dir(name, version)
  if e, h, err := check_cached(name, version); e != nil {
    if err != nil {
      # changed after it was downloaded: never reuse it, download it again
      os.stderr("the cached copy of " + name + "@" + version + " was changed; downloading it again\n")
      fetch_log = append(fetch_log, "the cached copy of " + name + "@" + version + " was changed: removed")
      fs.remove_all(dst)
      os.remove(info_file(dst))
    } else {
      if e.hash == "" { write_info(dst, e.commit, h) }      # an old copy: record its hash now
      if want_hash != "" && h != want_hash {
        return nil, errors.New("checksum mismatch for " + name + "@" + version + " in the cache " + dst + "\n  caju.lock: " + want_hash + "\n  files:     " + h + "\nThe cached files were changed. Delete that directory and run caju pkg install to download it again.")
      }
      fetch_log = append(fetch_log, "reused " + name + "@" + version + " from the cache (hash checked)")
      return &Fetched{dir: dst, commit: e.commit, hash: h}, nil
    }
  }
  os.stderr("downloading " + name + "@" + version + "\n")
  err := fs.mkdir_all(path.join(home(), "tmp"), 0o755)
  if err != nil { return nil, err }
  tmp, err2 := fs.temp_dir(path.join(home(), "tmp"), "dl-")
  if err2 != nil { return nil, err2 }
  defer fs.remove_all(tmp)
  src := path.join(tmp, "src")
  _, err = git([]str{"-c", "advice.detachedHead=false", "clone", "--quiet", "--depth", "1", "--branch", "v" + version, source_url(name), src})
  if err != nil { return nil, errors.New("cannot download " + name + "@" + version + " (git tag v" + version + " of " + source_url(name) + "): " + err.Error()) }
  commit, err3 := git([]str{"-C", src, "rev-parse", "HEAD"})
  if err3 != nil { return nil, err3 }
  err = fs.remove_all(path.join(src, ".git"))
  if err != nil { return nil, err }
  h, err4 := hash_dir(src)
  if err4 != nil { return nil, err4 }
  if want_commit != "" && commit != want_commit {
    return nil, errors.New("the tag v" + version + " of " + name + " has moved\n  caju.lock: commit " + want_commit + "\n  now:       commit " + commit + "\nA published version must not change. If you trust the new content, remove the package from caju.lock and install again.")
  }
  if want_hash != "" && h != want_hash {
    return nil, errors.New("checksum mismatch for " + name + "@" + version + "\n  caju.lock:  " + want_hash + "\n  downloaded: " + h + "\nThe downloaded files are not the ones the lock was made with.")
  }
  err = fs.mkdir_all(path.dir(dst), 0o755)
  if err != nil { return nil, err }
  # a directory left without .info by an interrupted download is not a copy
  if fs.is_dir(dst) && !os.exists(info_file(dst)) { fs.remove_all(dst) }
  err = fs.rename(src, dst)
  if err != nil {
    # another caju (another project) stored the same release meanwhile: use it if it checks out
    if e, h2, err5 := check_cached(name, version); e != nil && err5 == nil && (want_hash == "" || h2 == want_hash) {
      return &Fetched{dir: dst, commit: e.commit, hash: h2}, nil
    }
    return nil, err
  }
  err = write_info(dst, commit, h)
  if err != nil { return nil, err }
  fetch_log = append(fetch_log, "downloaded " + name + "@" + version + " (commit " + short_commit(commit) + ", " + h + ")")
  return &Fetched{dir: dst, commit: commit, hash: h}, nil
}

# every copy in the cache, sorted by name and version
export fn cache_entries() -> []*CacheEntry {
  out := []*CacheEntry{}
  base := path.join(home(), "pkg")
  files, err := fs.walk_files(base)
  if err != nil { return out }
  for _, f := range files {
    if !strings.has_suffix(f, ".info") { continue }
    rel := strings.trim_suffix(f, ".info")
    i := strings.last_index(rel, "@")
    if i < 0 { continue }
    dir := path.join(base, rel)
    commit, hash, ok := read_info(dir)
    if !ok { continue }
    out = append(out, &CacheEntry{name: rel[0:i], version: rel[i + 1:], dir: dir, commit: commit, hash: hash})
  }
  # sort: name, then version (insertion sort: caches are small)
  for i := 1; i < len(out); i++ {
    j := i
    while j > 0 && (out[j].name < out[j - 1].name || (out[j].name == out[j - 1].name && cmp_text(out[j].version, out[j - 1].version) < 0)) {
      t := out[j]
      out[j] = out[j - 1]
      out[j - 1] = t
      j--
    }
  }
  return out
}

# removes the copies of name ("" = all) at version ("" = every version); how many were removed
export fn cache_clean(name: str, version: str) -> (int, error) {
  n := 0
  for _, e := range cache_entries() {
    if name != "" && e.name != name { continue }
    if version != "" && e.version != version { continue }
    err := os.remove(info_file(e.dir))
    if err != nil { return n, err }
    err = fs.remove_all(e.dir)
    if err != nil { return n, err }
    n++
  }
  if name == "" { fs.remove_all(path.join(home(), "tmp")) }
  return n, nil
}

# the size of a directory's files, in bytes
fn dir_size(dir: str) -> int {
  files, err := fs.walk_files(dir)
  if err != nil { return 0 }
  n := 0
  for _, f := range files {
    fi, err2 := fs.lstat(path.join(dir, f))
    if err2 == nil { n += fi.size }
  }
  return n
}

# ---------------------------------------------------------------- resolving

struct Want {
  name: str
  version: str
  by: str          # who asks for it ("name@version" or the project's name)
}

struct Resolver {
  pins: map[str]*Locked         # name@version -> entry of the old caju.lock
  seen: map[str]*Locked         # name@version -> what we found
  selected: map[str]str         # name -> chosen version
  asked: map[str][]str          # name -> "version (by)" for error messages
}

# minimal version selection over the whole graph: every version asked for anywhere is visited
# (its dependencies count too), and each package ends at the highest version asked for
fn resolve(m: *Manifest, old: *Lock) -> (*Lock, error) {
  cerr := check_compiler(m.name, m.caju)
  if cerr != nil { return nil, cerr }
  r := &Resolver{pins: map[str]*Locked{}, seen: map[str]*Locked{}, selected: map[str]str{}, asked: map[str][]str{}}
  if old != nil { for _, l := range old.pkgs { r.pins[l.name + "@" + l.version] = l } }
  queue := []*Want{}
  for _, d := range m.deps { queue = append(queue, &Want{name: d.name, version: d.version, by: m.name}) }
  i := 0
  while i < len(queue) {
    w := queue[i]
    i++
    if w.name == m.name { return nil, errors.New(w.by + " depends on " + m.name + ", the project itself") }
    r.asked[w.name] = append(r.asked[w.name], w.version + " (by " + w.by + ")")
    cur, has := r.selected[w.name]
    if !has || cmp_text(w.version, cur) > 0 {
      if has {
        a, _ := parse_version(cur)
        b, _ := parse_version(w.version)
        if a.major != b.major { return nil, errors.New(w.name + " is needed in different major versions: " + strings.join(r.asked[w.name], ", ") + "; they are not compatible") }
      }
      r.selected[w.name] = w.version
    } else {
      a, _ := parse_version(cur)
      b, _ := parse_version(w.version)
      if a.major != b.major { return nil, errors.New(w.name + " is needed in different major versions: " + strings.join(r.asked[w.name], ", ") + "; they are not compatible") }
    }
    key := w.name + "@" + w.version
    if _, ok := r.seen[key]; ok { continue }
    pin := r.pins[key]
    want_commit := ""
    want_hash := ""
    if pin != nil {
      want_commit = pin.commit
      want_hash = pin.hash
    }
    f, err := fetch(w.name, w.version, want_commit, want_hash)
    if err != nil { return nil, err }
    dm, err2 := read_manifest(f.dir)
    if err2 != nil { return nil, errors.New(w.name + "@" + w.version + ": " + err2.Error()) }
    if dm.name != w.name { return nil, errors.New(w.name + "@" + w.version + ": its caju.toml says the name is " + dm.name) }
    err = check_compiler(w.name + "@" + w.version, dm.caju)
    if err != nil { return nil, err }
    if dm.version != w.version { return nil, errors.New(w.name + ": the tag v" + w.version + " has version = \"" + dm.version + "\" in its caju.toml") }
    l := &Locked{name: w.name, version: w.version, source: source_url(w.name), commit: f.commit, hash: f.hash, deps: requires_of(dm)}
    if os.getenv("CAJU_PKG_SOURCE") != "" { l.source = "https://" + w.name }
    r.seen[key] = l
    for _, d := range dm.deps { queue = append(queue, &Want{name: d.name, version: d.version, by: key}) }
  }
  names := []str{}
  for n, _ := range r.selected { names = append(names, n) }
  sort_strs(names)
  lk := &Lock{requires: requires_of(m), pkgs: []*Locked{}}
  for _, n := range names { lk.pkgs = append(lk.pkgs, r.seen[n + "@" + r.selected[n]]) }
  return lk, nil
}

fn sort_strs(xs: []str) {
  for i := 1; i < len(xs); i++ {
    j := i
    while j > 0 && xs[j] < xs[j - 1] {
      t := xs[j]
      xs[j] = xs[j - 1]
      xs[j - 1] = t
      j--
    }
  }
}

# ---------------------------------------------------------------- the project

# the directory with caju.toml that holds dir (dir itself or a parent), or ""
export fn find_root(dir: str) -> str {
  d := path.abs(dir)
  while true {
    if os.exists(path.join(d, "caju.toml")) { return d }
    if d == "/" { return "" }
    d = path.dir(d)
  }
  return ""
}

# makes sure every package in caju.lock is in the cache with the right hash, resolving again if
# caju.toml changed since the lock was written; writes caju.lock when it changes
export fn install(root: str) -> (*Lock, error) {
  m, err := read_manifest(root)
  if err != nil { return nil, err }
  lock_file := path.join(root, "caju.lock")
  let old: *Lock = nil
  if os.exists(lock_file) {
    lk, err2 := read_lock(lock_file)
    if err2 != nil { return nil, err2 }
    old = lk
  }
  if old != nil && same_list(old.requires, requires_of(m)) {
    err = check_compiler(m.name, m.caju)
    if err != nil { return nil, err }
    for _, l := range old.pkgs {
      f, err3 := fetch(l.name, l.version, l.commit, l.hash)
      if err3 != nil { return nil, err3 }
      dm, err5 := read_manifest(f.dir)
      if err5 != nil { return nil, err5 }
      err = check_compiler(l.name + "@" + l.version, dm.caju)
      if err != nil { return nil, err }
    }
    return old, nil
  }
  lk, err4 := resolve(m, old)
  if err4 != nil { return nil, err4 }
  err = os.write_file(lock_file, encode_lock(lk), 0o644)
  if err != nil { return nil, err }
  return lk, nil
}

# the packages a program can import, for the compiler: nil if the program is not in a project
# with dependencies. Checks that caju.lock is up to date and that the cached files match it.
export fn packages_for(entry: str) -> (map[str]*project.Package, error) {
  root := find_root(path.dir(path.abs(entry)))
  if root == "" { return nil, nil }
  m, err := read_manifest(root)
  if err != nil { return nil, err }
  err = check_compiler(m.name, m.caju)
  if err != nil { return nil, err }
  pkgs := map[str]*project.Package{}
  if len(m.deps) == 0 { return pkgs, nil }
  lock_file := path.join(root, "caju.lock")
  if !os.exists(lock_file) { return nil, errors.New("caju.toml has dependencies but there is no caju.lock; run caju pkg install") }
  lk, err2 := read_lock(lock_file)
  if err2 != nil { return nil, err2 }
  if !same_list(lk.requires, requires_of(m)) { return nil, errors.New("caju.lock is out of date with caju.toml; run caju pkg install") }
  for _, l := range lk.pkgs {
    dir := cache_dir(l.name, l.version)
    if !fs.is_dir(dir) { return nil, errors.New(l.name + "@" + l.version + " is not installed; run caju pkg install") }
    h, err3 := hash_dir(dir)
    if err3 != nil { return nil, err3 }
    if h != l.hash {
      return nil, errors.New("checksum mismatch for " + l.name + "@" + l.version + " in " + dir + "\n  caju.lock: " + l.hash + "\n  files:     " + h + "\nThe cached files were changed. Delete that directory and run caju pkg install.")
    }
    pm, err4 := read_manifest(dir)
    if err4 != nil { return nil, err4 }
    err = check_compiler(l.name + "@" + l.version, pm.caju)
    if err != nil { return nil, err }
    pkgs[l.name] = &project.Package{name: l.name, dir: dir, entry: pm.entry}
  }
  return pkgs, nil
}

# ---------------------------------------------------------------- operations
# What the commands do, as functions that return their report and an error instead of exiting:
# `caju pkg` prints them, `caju mcp` returns them to the assistant.

fn split_at(spec: str) -> (str, str) {
  i := strings.index(spec, "@")
  if i < 0 { return spec, "" }
  return spec[0:i], strings.trim_prefix(spec[i + 1:], "v")
}

fn edit_file(file: str, f: fn(str) -> str) -> error {
  src, err := os.read_file(file)
  if err != nil { return err }
  return os.write_file(file, f(src), 0o644)
}

# installs what caju.lock lists (resolving again if caju.toml changed)
export fn install_report(root: str) -> (str, error) {
  lk, err := install(root)
  if err != nil { return "", err }
  return str(len(lk.pkgs)) + " packages ok", nil
}

# adds name[@version] (default: the latest release) to caju.toml and installs it
export fn add(root: str, spec: str) -> (str, error) {
  name, version := split_at(spec)
  err := check_name(name)
  if err != nil { return "", err }
  if version == "" {
    v, err2 := latest_version(name)
    if err2 != nil { return "", err2 }
    version = v
  }
  _, err = parse_version(version)
  if err != nil { return "", err }
  m, err3 := read_manifest(root)
  if err3 != nil { return "", err3 }
  if name == m.name { return "", errors.New("a package cannot depend on itself") }
  file := path.join(root, "caju.toml")
  before, _ := os.read_file(file)
  err = edit_file(file, fn(src: str) -> str { return set_dependency(src, name, version) })
  if err != nil { return "", err }
  lk, err4 := install(root)
  if err4 != nil {
    os.write_file(file, before, 0o644)          # leave caju.toml as it was
    return "", err4
  }
  return "added " + name + "@" + version + "; " + str(len(lk.pkgs)) + " packages ok", nil
}

# removes a dependency from caju.toml (it stays if another dependency still needs it)
export fn remove(root: str, name: str) -> (str, error) {
  file := path.join(root, "caju.toml")
  src, err := os.read_file(file)
  if err != nil { return "", err }
  out, found := remove_dependency(src, name)
  if !found { return "", errors.New(name + " is not in [dependencies]") }
  err = os.write_file(file, out, 0o644)
  if err != nil { return "", err }
  lk, err2 := install(root)
  if err2 != nil {
    os.write_file(file, src, 0o644)              # leave caju.toml as it was
    return "", err2
  }
  return "removed " + name + "; " + str(len(lk.pkgs)) + " packages ok", nil
}

# moves the dependencies (or only `only`) to their latest release and installs
export fn update(root: str, only: str) -> (str, error) {
  m, err := read_manifest(root)
  if err != nil { return "", err }
  lines := []str{}
  found := false
  for _, d := range m.deps {
    if only != "" && only != d.name { continue }
    found = true
    v, err2 := latest_version(d.name)
    if err2 != nil { return "", err2 }
    if v != d.version {
      lines = append(lines, d.name + " " + d.version + " -> " + v)
      err = edit_file(path.join(root, "caju.toml"), fn(src: str) -> str { return set_dependency(src, d.name, v) })
      if err != nil { return "", err }
    }
  }
  if only != "" && !found { return "", errors.New(only + " is not in [dependencies]") }
  r, err3 := install_report(root)
  if err3 != nil { return "", err3 }
  lines = append(lines, r)
  return strings.join(lines, "\n"), nil
}

# checks every package of caju.lock in the cache against the lock; bad counts the problems
export fn verify(root: str) -> (report: str, bad: int, err: error) {
  lk, err2 := read_lock(path.join(root, "caju.lock"))
  if err2 != nil { return "", 0, err2 }
  lines := []str{}
  for _, l := range lk.pkgs {
    dir := cache_dir(l.name, l.version)
    if !fs.is_dir(dir) {
      lines = append(lines, "missing  " + l.name + "@" + l.version + " (run caju pkg install)")
      bad++
      continue
    }
    h, err3 := hash_dir(dir)
    if err3 != nil { return "", 0, err3 }
    if h == l.hash { lines = append(lines, "ok       " + l.name + "@" + l.version + " " + h) } else {
      lines = append(lines, "MISMATCH " + l.name + "@" + l.version + "\n  caju.lock: " + l.hash + "\n  files:     " + h)
      bad++
    }
  }
  return strings.join(lines, "\n"), bad, nil
}

# the dependency tree of the project, from caju.lock
export fn tree(root: str) -> (str, error) {
  m, err := read_manifest(root)
  if err != nil { return "", err }
  lk, err2 := read_lock(path.join(root, "caju.lock"))
  if err2 != nil { return "", errors.New("no caju.lock (run caju pkg install)") }
  chosen := map[str]*Locked{}
  for _, l := range lk.pkgs { chosen[l.name] = l }
  out := []str{m.name + "@" + m.version}
  tree_level(&out, requires_of(m), chosen, "", map[str]bool{})
  return strings.join(out, "\n"), nil
}

fn tree_level(out: *[]str, reqs: []str, chosen: map[str]*Locked, indent: str, path_: map[str]bool) {
  for i, r := range reqs {
    name, min := split_at(r)
    last := i == len(reqs) - 1
    branch := "├── "
    next := "│   "
    if last {
      branch = "└── "
      next = "    "
    }
    l := chosen[name]
    if l == nil {
      *out = append(*out, indent + branch + r + " (not in caju.lock)")
      continue
    }
    note := ""
    if l.version != min { note = " (needs " + min + ")" }
    *out = append(*out, indent + branch + name + "@" + l.version + note)
    if path_[name] { continue }
    path_[name] = true
    tree_level(out, l.deps, chosen, indent + next, path_)
    delete(path_, name)
  }
}

fn short_commit(c: str) -> str {
  if len(c) > 12 { return c[0:12] }
  return c
}

fn human_size(n: int) -> str {
  if n >= 1 << 20 { return str(n / (1 << 20)) + "." + str(n % (1 << 20) * 10 / (1 << 20)) + " MB" }
  if n >= 1024 { return str(n / 1024) + " KB" }
  return str(n) + " B"
}

# the cache, one line per copy; with check, each copy's files against its recorded hash
export fn cache_report(check: bool) -> (report: str, bad: int) {
  lines := []str{}
  total := 0
  entries := cache_entries()
  for _, e := range entries {
    size := dir_size(e.dir)
    total += size
    status := ""
    if check {
      _, h, err := check_cached(e.name, e.version)
      if err != nil {
        status = "CHANGED  "
        bad++
      } else if e.hash == "" {
        status = "ok (recorded now) "
        write_info(e.dir, e.commit, h)
      } else { status = "ok       " }
    }
    lines = append(lines, status + e.name + "@" + e.version + "  " + short_commit(e.commit) + "  " + human_size(size))
  }
  lines = append(lines, str(len(entries)) + " packages, " + human_size(total) + " in " + path.join(home(), "pkg"))
  return strings.join(lines, "\n"), bad
}

# ---------------------------------------------------------------- the command

fn die(msg: str) {
  os.eprintln("caju pkg: " + msg)
  os.exit(1)
}

fn project_root() -> str {
  r := find_root(".")
  if r == "" { die("no caju.toml here or in a parent directory (create one with caju pkg init)") }
  return r
}

fn print_or_die(out: str, err: error) {
  if err != nil { die(err.Error()) }
  if out != "" { print(out) }
}

fn cmd_init(name: str) {
  if os.exists("caju.toml") { die("caju.toml already exists") }
  if name == "" {
    out, err := git([]str{"remote", "get-url", "origin"})
    if err == nil {
      u := strings.trim_suffix(out, ".git")
      u = strings.replace_all(u, "git@github.com:", "github.com/")
      u = strings.trim_prefix(u, "https://")
      name = u
    }
  }
  if name == "" { die("give the package name: caju pkg init github.com/owner/repo") }
  err := check_name(name)
  if err != nil { die(err.Error()) }
  src := "[package]\nname = \"" + name + "\"\nversion = \"0.1.0\"\ndescription = \"\"\nlicense = \"\"\nauthors = []\ncaju = \">=" + VERSION + "\"\n\n[dependencies]\n"
  err = os.write_file("caju.toml", src, 0o644)
  if err != nil { die(err.Error()) }
  print("created caju.toml for " + name)
}

fn print_report(out: str, bad: int) {
  print(out)
  if bad > 0 { os.exit(1) }
}

# `caju pkg ...`, declared under the program's command line
export fn register(app: *cli.Command) {
  p := app.sub("pkg", "Manage the packages of a project (caju.toml, caju.lock)")
  p.describe("Packages are GitHub repositories (github.com/owner/repo) with releases tagged vX.Y.Z.\nDownloads go to a cache shared by every project and are reused only if their files\nstill have the hash recorded when they were downloaded (docs/packages.md).")

  c_init := p.sub("init", "Create caju.toml")
  c_init.arg_opt("name", "github.com/owner/repo (default: from the git origin remote)")
  c_init.action(fn(m: *cli.Match) { cmd_init(m.arg("name")) })

  c_add := p.sub("add", "Add a dependency and install it")
  c_add.arg("package", "github.com/owner/repo, optionally @version (default: the latest release)")
  c_add.example("caju pkg add github.com/cajulang/web", "the latest release")
  c_add.example("caju pkg add github.com/acme/greet@0.2.0", "a given version")
  c_add.action(fn(m: *cli.Match) {
    out, err := add(project_root(), m.arg("package"))
    print_or_die(out, err)
  })

  c_rm := p.sub("remove", "Remove a dependency")
  c_rm.arg("package", "github.com/owner/repo")
  c_rm.action(fn(m: *cli.Match) {
    out, err := remove(project_root(), m.arg("package"))
    print_or_die(out, err)
  })

  c_up := p.sub("update", "Move dependencies to their latest release")
  c_up.arg_opt("package", "only this one (default: all)")
  c_up.action(fn(m: *cli.Match) {
    out, err := update(project_root(), m.arg("package"))
    print_or_die(out, err)
  })

  p.sub("install", "Download what caju.lock lists (resolving again if caju.toml changed)").action(fn(m: *cli.Match) {
    out, err := install_report(project_root())
    print_or_die(out, err)
  })
  p.sub("verify", "Check the cached packages against the hashes in caju.lock").action(fn(m: *cli.Match) {
    out, bad, err := verify(project_root())
    if err != nil { die(err.Error()) }
    print_report(out, bad)
  })
  p.sub("tree", "Show the dependency tree").action(fn(m: *cli.Match) {
    out, err := tree(project_root())
    print_or_die(out, err)
  })
  h := p.sub("hash", "Print the hash of a package directory")
  h.arg_opt("dir", "the directory (default: the current one)")
  h.action(fn(m: *cli.Match) {
    dir := m.arg("dir")
    if dir == "" { dir = "." }
    out, err := hash_dir(dir)
    print_or_die(out, err)
  })

  c := p.sub("cache", "The downloaded packages, shared by every project (default: list)")
  c.action(fn(m: *cli.Match) {
    out, bad := cache_report(false)
    print_report(out, bad)
  })
  c.sub("list", "List the cached packages with their commit and size").action(fn(m: *cli.Match) {
    out, bad := cache_report(false)
    print_report(out, bad)
  })
  c.sub("verify", "Check every cached package against the hash recorded when it was downloaded").action(fn(m: *cli.Match) {
    out, bad := cache_report(true)
    print_report(out, bad)
  })
  cl := c.sub("clean", "Remove cached packages")
  cl.arg_opt("package", "name or name@version (default: everything)")
  cl.action(fn(m: *cli.Match) {
    name, version := split_at(m.arg("package"))
    n, err := cache_clean(name, version)
    if err != nil { die(err.Error()) }
    print("removed " + str(n) + " cached packages")
  })
  c.sub("dir", "Print where the cache is").action(fn(m: *cli.Match) { print(path.join(home(), "pkg")) })
}
