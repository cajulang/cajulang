# Raw memory: alloc, free, peek*, poke*, readstr, readwstr. They exist for the arguments and
# results of DLL calls (extern), so only Windows has them; elsewhere a program that can reach them
# is refused at compile time (docs/platforms.md). compiler/windows_test.caju builds and runs
# testdata/windows/memory.caju on Windows.
import { describe, it, expect, run_file } from "std/testing"

describe("raw memory", fn() {
  it("is refused at compile time outside Windows", fn() {
    r := run_file("testdata/null_peek.caju")
    expect(r.output).to_start_with("Platform error in null_peek.caju, line 1: peek32 is not available when compiling for ")
    expect(r.output).to_end_with(": it runs on windows (raw memory for DLL calls).")
    expect(r.code).to_equal(1)
  })
  it("poke checks the type of the value when compiling", fn() {
    r := run_file("testdata/poke_type.caju")
    expect(r.output).to_equal("Type error in poke_type.caju, line 4: poke32 expects int as argument 2, but got str.")
    expect(r.code).to_equal(1)
  })
})
